<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (5.4 layout): tabs instead of one long scrolling form. Styles: UI\Xaml\Theme.xaml.
     All x:Name values are used by Show-YumSettings in UI\Dialogs.ps1 (FindName works across tabs). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Settings" Width="820" Height="640" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <!-- One settings row: label + hint on the left, control on the right. -->
    <Style x:Key="RowLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,2,16,0"/></Style>
    <Style x:Key="Row" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,14"/></Style>
  </Window.Resources>
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Settings" Style="{StaticResource AppTitle}"/>
      <TextBlock Text="Changes are saved to config.json next to YUMRAM when you press Apply." Style="{StaticResource Caption}" Margin="0,2,0,6"/>
    </StackPanel>

    <TabControl Grid.Row="1">
      <!-- ============ General ============ -->
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Style="{StaticResource Card}" Margin="0,4,4,4"><StackPanel>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Memory goal (GB)" Style="{StaticResource RowLabel}"/><TextBlock Text="Keep at least this much RAM available. YUMRAM shows what is reachable on this PC next to the goal." Style="{StaticResource RowHint}"/></StackPanel>
              <TextBox x:Name="MinimumAvailable" Grid.Column="1" VerticalAlignment="Top"/></Grid>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Mode" Style="{StaticResource RowLabel}"/><TextBlock Text="How far YUMRAM may go when freeing RAM. Safe: only low-risk idle apps. Balanced (recommended): also signed apps. Aggressive: any identified app. Windows, security, drivers and your game are never touched." Style="{StaticResource RowHint}"/></StackPanel>
              <ComboBox x:Name="Mode" Grid.Column="1" VerticalAlignment="Top"><ComboBoxItem Content="Safe — minimal intervention" Tag="Safe"/><ComboBoxItem Content="Balanced — recommended" Tag="Balanced"/><ComboBoxItem Content="Aggressive — maximum reclaim" Tag="Aggressive"/></ComboBox></Grid>
            <CheckBox x:Name="StartMonitoringAutomatically" Content="Start monitoring automatically when YUMRAM opens"/>
            <CheckBox x:Name="ShowTrayIcon" Content="Show RAM % in the notification area (tray icon)" Margin="0,8,0,0"/>
            <CheckBox x:Name="MinimizeToTray" Content="Minimize to the notification area instead of the taskbar" Margin="0,8,0,0"/>
            <CheckBox x:Name="MiniBarOnMinimize" Content="Minimize or close to a small floating bar (RAM, CPU, GPU, disk) instead of hiding completely" Margin="0,8,0,0" ToolTip="The bar stays on top and can be dragged anywhere. Its – button hides it to the tray icon near the clock (it may be under the ^ arrow)."/>
            <CheckBox x:Name="CloseToBackground" Content="The X button keeps YUMRAM running in the background (quit from the tray icon: Exit YUMRAM)" Margin="0,8,0,0" ToolTip="On: closing the window hides it and YUMRAM keeps protecting your RAM and games. Right-click the tray icon (near the clock) and choose Exit YUMRAM to quit fully."/>
            <TextBlock Text="Changes apply as soon as you press Apply." Style="{StaticResource Caption}" Margin="27,2,0,0"/>
            <Grid Style="{StaticResource Row}" Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Administrator rights" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Needed for Deep reclaim (emptying Windows' memory cache), cleaning Windows' own files in Disk cleanup, identifying hidden system programs, and 'all users' startup apps." Style="{StaticResource RowHint}"/></StackPanel>
              <ComboBox x:Name="ElevationMode" Grid.Column="1" VerticalAlignment="Top">
                <ComboBoxItem Content="Ask each time (Windows prompt)" Tag="Ask"/>
                <ComboBoxItem Content="Start without asking (set up once)" Tag="NoPrompt"/>
                <ComboBoxItem Content="Never - run without administrator" Tag="Never"/>
              </ComboBox></Grid>
            <TextBlock x:Name="ElevationHint" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <CheckBox x:Name="StartWithWindows" Content="Start YUMRAM when I sign in to Windows" Margin="0,0,0,4"/>
            <CheckBox x:Name="UpdateCheckEnabled" Content="Check GitHub for a new YUMRAM (every 15 minutes)" Margin="0,10,0,0"/>
            <CheckBox x:Name="UpdateAutoInstall" Content="Install new versions as soon as they come out (checked with SHA-256, never while you play; settings are kept)" Margin="27,6,0,0" ToolTip="Off: you see a banner and choose when to install."/>
            <CheckBox x:Name="GlobalHotkeyEnabled" Content="Global shortcut for Free RAM now (works even from a game or the tray)" Margin="0,10,0,0"/>
            <Grid Margin="27,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBox x:Name="GlobalHotkey" ToolTip="For example Ctrl+Alt+R or Ctrl+Shift+F9. Needs at least one of Ctrl, Alt, Shift or Win." AutomationProperties.Name="Global shortcut"/>
              <TextBlock x:Name="HotkeyState" Grid.Column="1" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/></Grid>
            <!-- 5.15.2: hidden - it only repeated the memory goal and confused people (kept for the code that fills it) -->
            <Grid Style="{StaticResource Row}" Margin="0,14,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Cleanup target (GB)" Style="{StaticResource RowLabel}" Foreground="{StaticResource TextMuted}"/><TextBlock Text="Read-only: always equal to the memory goal." Style="{StaticResource RowHint}"/></StackPanel>
              <TextBox x:Name="CleanupTarget" Grid.Column="1" IsReadOnly="True" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" ToolTip="Kept for compatibility. The memory goal is the single source of truth."/></Grid>
          </StackPanel></Border>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Cleanup ============ -->
      <TabItem Header="Cleanup">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,4,4">
            <GroupBox Header="Timing">
              <StackPanel>
                <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Minimum time between cleanups (s)" Style="{StaticResource RowLabel}"/><TextBlock Text="Automatic cleanup waits at least this long before starting again." Style="{StaticResource RowHint}"/></StackPanel>
                  <TextBox x:Name="CleanInterval" Grid.Column="1" VerticalAlignment="Top"/></Grid>
                <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Rest time for each program (s)" Style="{StaticResource RowLabel}"/><TextBlock Text="A trimmed program is left alone this long, so busy apps are not trimmed over and over." Style="{StaticResource RowHint}"/></StackPanel>
                  <TextBox x:Name="ProcessCooldown" Grid.Column="1" VerticalAlignment="Top"/></Grid>
                <Grid Style="{StaticResource Row}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Extra margin above the goal (GB)" Style="{StaticResource RowLabel}"/><TextBlock Text="Once automatic care starts, it aims this much above the goal (0 to 2 GB), so it is not triggered again a moment later." Style="{StaticResource RowHint}"/></StackPanel>
                  <TextBox x:Name="Hysteresis" Grid.Column="1" VerticalAlignment="Top"/></Grid>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="When automatic care starts (% of RAM in use) and how many programs it handles per round, for each mode">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Text="Starts at % RAM used" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
                <TextBlock Grid.Column="3" Text="Programs per round" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="Safe" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                <TextBox x:Name="SafePressure" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/><TextBox x:Name="SafePass" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="Balanced" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                <TextBox x:Name="BalancedPressure" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/><TextBox x:Name="BalancedPass" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Text="Aggressive" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                <TextBox x:Name="AggressivePressure" Grid.Row="3" Grid.Column="1"/><TextBox x:Name="AggressivePass" Grid.Row="3" Grid.Column="3"/>
              </Grid>
            </GroupBox>
            <GroupBox Header="Optional extras">
              <StackPanel>
                <CheckBox x:Name="EnableOptionalBackground" Content="Close approved optional background apps when RAM is low (they are asked to close, never killed)"/>
                <CheckBox x:Name="EnableOptionalServices" Content="Temporarily stop approved optional services (restarted when YUMRAM exits)"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Gaming ============ -->
      <TabItem Header="Gaming">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Style="{StaticResource Card}" Margin="0,4,4,4"><StackPanel>
            <CheckBox x:Name="AutoDetectGames" Content="Detect games automatically"/>
            <CheckBox x:Name="ProtectGame" Content="Never trim the active game"/>
            <CheckBox x:Name="AutoCleanOnGameStart" Content="Free RAM when a game starts"/>
            <CheckBox x:Name="GameStandbyGuard" Content="Anti-stutter while I play: empty Windows' standby cache when free memory runs low (administrator)" Margin="0,6,0,0" ToolTip="Like ISLC: while a game runs, when free memory is below 1 GB and the standby cache is above 1 GB, YUMRAM empties the standby cache (at most every 30 s). Helps some games that stutter when Windows is slow to hand out memory. Off by default."/>
            <Grid Style="{StaticResource Row}" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Game CPU priority" Style="{StaticResource RowLabel}"/><TextBlock Text="CPU scheduling only; this does not add RAM or GPU power." Style="{StaticResource RowHint}"/></StackPanel>
              <ComboBox x:Name="GamePriority" Grid.Column="1" VerticalAlignment="Top"><ComboBoxItem Content="Keep existing"/><ComboBoxItem Content="Normal (default)"/><ComboBoxItem Content="Above normal (game preference)"/><ComboBoxItem Content="High (advanced)"/></ComboBox></Grid>
          </StackPanel></Border>
        </ScrollViewer>
      </TabItem>

      <!-- ============ CPU (5.8) ============ -->
      <TabItem Header="CPU">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Style="{StaticResource Card}" Margin="0,4,4,4"><StackPanel>
            <CheckBox x:Name="CpuBalanceEnabled" Content="CPU balance: keep the app I am using smooth when a background program hogs the CPU"/>
            <TextBlock Text="YUMRAM briefly lowers the busy background program's priority and puts it back as soon as it calms down. The app you are using, your game, Windows and services are never touched. Works whether or not memory monitoring is on." Style="{StaticResource Caption}" Margin="27,2,0,14" TextWrapping="Wrap"/>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="How strong" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Gentle: the busy background program just waits its turn behind your app. Balanced (recommended): also keeps it off part of the CPU so your app or game has room, and undoes that if it did not help. Strong: puts it in Windows' Efficiency mode (like Task Manager's leaf icon) and steps in sooner - best on battery." Style="{StaticResource RowHint}" TextWrapping="Wrap"/></StackPanel>
              <ComboBox x:Name="CpuCareLevel" Grid.Column="1" VerticalAlignment="Top">
                <ComboBoxItem Content="Gentle" Tag="Gentle"/>
                <ComboBoxItem Content="Balanced — recommended" Tag="Balanced"/>
                <ComboBoxItem Content="Strong" Tag="Strong"/>
              </ComboBox></Grid>
            <CheckBox x:Name="CpuCareStrongOnBattery" Content="Use Strong automatically on a laptop running on battery (saves power and heat)" Margin="0,0,0,10"/>
            <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="THIS PC" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="CpuProfileText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <CheckBox x:Name="CpuCareAdaptive" Content="While I play, use the level this PC's game benchmark found best" Margin="0,12,0,0" ToolTip="Only while a detected game is in front, and only when the benchmark showed the other level clearly better (10 % or more on repeated runs) for that kind of game and background load."/>
                <TextBlock x:Name="CpuKnowledgeText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button x:Name="CpuBench" Content="Measure games on this PC (about 15 min)" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Runs YUMRAM's own test game next to test background loads with every CPU care level. Your programs are not touched. Close games and keep the laptop plugged in."/>
              </StackPanel>
            </Border>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Step in when the whole PC is at least (%)" Style="{StaticResource RowLabel}"/><TextBlock Text="Total CPU use. Below this nothing is changed. Default 70." Style="{StaticResource RowHint}"/></StackPanel>
              <TextBox x:Name="CpuSystemPercent" Grid.Column="1" VerticalAlignment="Top"/></Grid>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="...and one background program uses at least (%)" Style="{StaticResource RowLabel}"/><TextBlock Text="Share of all CPU cores, for 2 seconds in a row. Default 10." Style="{StaticResource RowHint}"/></StackPanel>
              <TextBox x:Name="CpuProcessPercent" Grid.Column="1" VerticalAlignment="Top"/></Grid>
            <Grid Style="{StaticResource Row}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Never hold back" Style="{StaticResource RowLabel}"/><TextBlock Text="Program names separated by commas, e.g. handbrake, obs64" Style="{StaticResource RowHint}"/></StackPanel>
              <TextBox x:Name="CpuExclusions" Grid.Column="1" VerticalAlignment="Top" AutomationProperties.Name="Programs CPU balance never holds back"/></Grid>
          </StackPanel></Border>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Monitoring ============ -->
      <TabItem Header="Monitoring">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Style="{StaticResource Card}" Margin="0,4,4,4"><StackPanel>
            <TextBlock Text="How often YUMRAM samples the system. Lower is more responsive but uses more CPU. Monitoring restarts by itself when you apply a change." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <TextBlock Text="RAM and CPU (seconds)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/><TextBox x:Name="TelemetryInterval" Grid.Column="1"/></Grid>
            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="GPU (seconds)" Style="{StaticResource RowLabel}"/><TextBlock Text="Minimum 5 s: reading GPU counters is relatively expensive." Style="{StaticResource RowHint}"/></StackPanel>
              <TextBox x:Name="GpuInterval" Grid.Column="1" VerticalAlignment="Top"/></Grid>
            <Grid Style="{StaticResource Row}" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <TextBlock Text="Game detection (seconds)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/><TextBox x:Name="GameInterval" Grid.Column="1"/></Grid>
          </StackPanel></Border>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Privacy & scanner ============ -->
      <TabItem Header="Privacy &amp; scanner">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,4,4">
            <GroupBox Header="Privacy">
              <StackPanel>
                <CheckBox x:Name="EnableOnlineResearch" Content="Online research for unidentified programs"/>
                <TextBlock Text="Sends the program, publisher and product name to Bing search, then opens up to 4 of the most trustworthy result pages (for example the publisher's own site) to check the answer - those sites see an ordinary page visit. Nothing else leaves your PC. When off, Intelligence still identifies programs locally (signatures, installed-software records, services, Store packages)." Style="{StaticResource Caption}" Margin="27,2,0,0"/>
                <CheckBox x:Name="CommunityShareEnabled" Content="Help everyone: share my game benchmark results (opt-in)" Margin="0,14,0,0"/>
                <TextBlock Text="Off unless you turn it on. After &quot;Measure games&quot; YUMRAM shares your CPU model and layout, laptop or desktop, Windows build, YUMRAM version and the frame rates its own test game reached - nothing else (no program names, files, user or PC names, no ID). You can see the exact text first." Style="{StaticResource Caption}" Margin="27,2,0,0" TextWrapping="Wrap"/>
                <Button x:Name="CommunityShareNow" Content="See and share my results now…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="27,6,0,0"/>
                <CheckBox x:Name="CommunityUseShared" Content="Use game results shared by other people with the same CPU" Margin="0,14,0,0"/>
                <TextBlock Text="Once a week YUMRAM downloads a public file of shared results from GitHub (the request carries nothing about you). Used only while you play, only when at least 3 people with your CPU agree, and only until this PC has measured games itself." Style="{StaticResource Caption}" Margin="27,2,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="System inventory scanner" Visibility="Collapsed">
              <StackPanel>
                <CheckBox x:Name="EnableSystemScanner" Content="Let Intelligence scan this PC (programs, services, Store apps, startup items)"/>
                <Grid Style="{StaticResource Row}" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Most items per kind (at least 500 are always checked)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/><TextBox x:Name="ScannerMaxItems" Grid.Column="1"/></Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Footer: message (only when there is one) + actions -->
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="Reset" Content="Reset defaults" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
        <Button x:Name="Close" Content="Close" Margin="0,0,8,0" MinWidth="80"/>
        <Button x:Name="Apply" Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      </StackPanel>
      <Border VerticalAlignment="Center" Margin="0,0,16,0" Padding="10,6" CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Style><Style TargetType="Border"><Style.Triggers>
          <DataTrigger Binding="{Binding Text, ElementName=Validation}" Value=""><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
          <DataTrigger Binding="{Binding Text, ElementName=Validation}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <TextBlock x:Name="Validation" Foreground="{StaticResource Warning}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
