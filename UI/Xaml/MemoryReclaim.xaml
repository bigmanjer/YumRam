<?xml version="1.0" encoding="utf-8"?>
<!-- RAM Reclaim Center (5.4 layout). Styles: UI\Xaml\Theme.xaml. All x:Name values are used by
     Show-YumMemoryReclaim in UI\Dialogs.ps1. No preview scan runs when the window opens. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - RAM Reclaim Center" Width="1040" Height="760" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,14">
      <Button x:Name="Close" DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}" VerticalAlignment="Top"/>
      <StackPanel>
        <TextBlock Text="RAM Reclaim Center" Style="{StaticResource AppTitle}"/>
        <TextBlock Text="Run a reclaim and see exactly what was trimmed and what Windows actually gave back." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        <TextBlock x:Name="Summary" Text="Ready." Foreground="{StaticResource Success}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <!-- Measurements -->
    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="RAM Windows can hand to programs right now (free + standby).">
        <StackPanel><TextBlock Text="AVAILABLE RAM" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Available" Text="-- GB" Style="{StaticResource StatValue}" Foreground="{StaticResource Success}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="File cache held by Windows (reusable; counts toward Available).">
        <StackPanel><TextBlock Text="SYSTEM CACHE" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Cache" Text="-- GB" Style="{StaticResource StatValue}" Foreground="{StaticResource Brand}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="Memory promised to programs, as a share of RAM + page file.">
        <StackPanel><TextBlock Text="COMMIT CHARGE" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Commit" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource Warning}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="Working-set memory trimmed by the last reclaim.">
        <StackPanel><TextBlock Text="TRIMMED LAST RUN" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Potential" Text="-- MB" Style="{StaticResource StatValue}" Foreground="{StaticResource Brand}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" ToolTip="Available RAM gained by the last reclaim, measured after Windows settled.">
        <StackPanel><TextBlock Text="LAST GAIN" Style="{StaticResource StatLabel}"/><TextBlock x:Name="LastGain" Text="-- GB" Style="{StaticResource StatValue}" Foreground="{StaticResource Success}"/></StackPanel></Border>
    </UniformGrid>

    <!-- Body -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="What the last reclaim did" Style="{StaticResource SectionTitle}" Margin="16,14,16,10"/>
          <ListView x:Name="Items" BorderThickness="0" Background="Transparent" Margin="1,0,1,1">
            <ListView.View><GridView>
              <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90"/>
              <GridViewColumn Header="Process / area" DisplayMemberBinding="{Binding Process}" Width="160"/>
              <GridViewColumn Header="PID" DisplayMemberBinding="{Binding PID}" Width="60"/>
              <GridViewColumn Header="Before MB" DisplayMemberBinding="{Binding BeforeMB}" Width="80"/>
              <GridViewColumn Header="Trimmed MB" DisplayMemberBinding="{Binding ReducedMB}" Width="90"/>
              <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="90"/>
              <GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="280"/>
            </GridView></ListView.View>
          </ListView>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Reclaim" Style="{StaticResource SectionTitle}"/>
              <Button x:Name="FreeRam" Content="💜 FREE RAM NOW" Style="{StaticResource PrimaryButton}" MinHeight="40"/>
              <Button x:Name="DeepReclaim" Content="💜 DEEP RAM RECLAIM" Margin="0,8,0,0"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                         Text="Free RAM trims idle, identified programs. Deep also flushes and purges Windows memory lists (administrator only); it is manual because emptying the cache can cause extra disk reads afterwards."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Progress" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="Activity" Text="Ready" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Result" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="Measurement" Text="No reclaim run yet. The real gain is measured after each action." TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="3" Margin="2,10,2,0">
      <TextBlock DockPanel.Dock="Right" Text="No preview scan on open; results are measured after each reclaim." Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="16,0,0,0"/>
      <TextBlock x:Name="Footer" Text="Ready" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
