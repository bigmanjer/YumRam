<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💜 YUMRAM - RAM Reclaim Center" Width="1020" Height="700" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#180D20" Foreground="#FFF7FF">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#9B5DE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="BB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BB" Property="Background" Value="#6A35A8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="BB" Property="Background" Value="#9B5DE5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="BB" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="Padding" Value="6,7"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#321B42"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#6A35A8"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="8"/><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#9B5DE5"/></Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#321B42" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="💜 RAM RECLAIM CENTER" FontSize="24" FontWeight="Bold" Foreground="#CFA8FF"/>
          <TextBlock Text="Run reclaim deliberately. Review what was actually reclaimed and what Windows returned. The Center does not pre-scan cleanup targets." Foreground="#C7B9D1" Margin="0,4,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="Summary" Text="Ready." Foreground="#86EFAC" FontWeight="SemiBold" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="Close" Content="CLOSE" Width="85" Height="38"/>
        </StackPanel>
      </Grid>
    </Border>
    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
      <Border Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3"><StackPanel><TextBlock Text="AVAILABLE" Foreground="#C7B9D1" FontSize="10"/><TextBlock x:Name="Available" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#86EFAC"/></StackPanel></Border>
      <Border Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3"><StackPanel><TextBlock Text="CACHE" Foreground="#C7B9D1" FontSize="10"/><TextBlock x:Name="Cache" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#CFA8FF"/></StackPanel></Border>
      <Border Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3"><StackPanel><TextBlock Text="COMMIT" Foreground="#C7B9D1" FontSize="10"/><TextBlock x:Name="Commit" Text="--%" FontSize="20" FontWeight="Bold" Foreground="#FDE68A"/></StackPanel></Border>
      <Border Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3"><StackPanel><TextBlock Text="POTENTIAL WS" Foreground="#C7B9D1" FontSize="10"/><TextBlock x:Name="Potential" Text="-- MB" FontSize="20" FontWeight="Bold" Foreground="#CFA8FF"/></StackPanel></Border>
      <Border Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="10" Padding="10" Margin="3"><StackPanel><TextBlock Text="LAST GAIN" Foreground="#C7B9D1" FontSize="10"/><TextBlock x:Name="LastGain" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#86EFAC"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,10,0">
        <ListView x:Name="Items" Background="Transparent" BorderThickness="0">
          <ListView.View><GridView>
            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="70"/>
            <GridViewColumn Header="Process / Area" DisplayMemberBinding="{Binding Process}" Width="150"/>
            <GridViewColumn Header="PID" DisplayMemberBinding="{Binding PID}" Width="55"/>
            <GridViewColumn Header="Before" DisplayMemberBinding="{Binding BeforeMB}" Width="75"/>
            <GridViewColumn Header="Reduced" DisplayMemberBinding="{Binding ReducedMB}" Width="80"/>
            <GridViewColumn Header="CPU" DisplayMemberBinding="{Binding CPU}" Width="55"/>
            <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="80"/>
            <GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="170"/>
          </GridView></ListView.View>
        </ListView>
      </Border>
      <StackPanel Grid.Column="1">
        <Border Background="#321B42" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="ONE-SHOT RECLAIM" FontSize="14" FontWeight="Bold" Foreground="#CFA8FF"/>
            <Button x:Name="FreeRam" Content="💜 FREE RAM NOW" Height="42" FontWeight="Bold" Margin="0,10,0,5"/>
            <Button x:Name="DeepReclaim" Content="💜 DEEP RAM RECLAIM" Height="38"/>
            <TextBlock Text="Quick reclaim favors low-risk process working sets. Deep reclaim can purge standby memory; this is deliberately manual because aggressive cache eviction can create page faults or I/O." Foreground="#C7B9D1" FontSize="10.5" TextWrapping="Wrap" Margin="3,8,3,0"/>
          </StackPanel>
        </Border>
        <Border Background="#24152F" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="PROGRESS" FontSize="14" FontWeight="Bold" Foreground="#CFA8FF"/>
            <TextBlock x:Name="Activity" Text="Ready" Foreground="#FFF7FF" Margin="0,7,0,5" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"/>
          </StackPanel>
        </Border>
        <Border Background="#1D1622" BorderBrush="#6A35A8" BorderThickness="1" CornerRadius="12" Padding="13">
          <StackPanel>
            <TextBlock Text="MEASUREMENT" FontSize="14" FontWeight="Bold" Foreground="#86EFAC"/>
            <TextBlock x:Name="Measurement" Text="No reclaim run yet. Actual RAM gain will be measured after each action." Foreground="#D8CBDD" Margin="0,7,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="Footer" Text="Ready 💜" Foreground="#BFAFC9"/><TextBlock Text="No preview scan on open. Actual gain and retained effect are measured after reclaim." DockPanel.Dock="Right" Foreground="#806E8A"/></DockPanel>
  </Grid>
</Window>
