<?xml version="1.0" encoding="utf-8"?>
<!-- RAM Reclaim Center (5.5 layout). Styles: UI\Xaml\Theme.xaml. All x:Name values are used by
     Show-YumMemoryReclaim in UI\Dialogs.ps1. No preview scan runs when the window opens.
     Layout: header (+ administrator status) -> live measurements -> what the last reclaim did | choose a reclaim + result. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - RAM Reclaim Center" Width="1120" Height="780" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Tick" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Border x:Name="AdminPill" Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock x:Name="AdminText" Text="Checking rights…" FontSize="12" FontWeight="SemiBold"/>
        </Border>
        <Button x:Name="Close" Content="Close" Style="{StaticResource GhostButton}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="RAM Reclaim Center" Style="{StaticResource AppTitle}"/>
        <TextBlock Text="Free up memory now and see exactly what was taken back from idle programs and how much more RAM programs really got." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="Summary" Text="Ready." Foreground="{StaticResource Success}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <!-- Measurements -->
    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,-10,14">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="RAM Windows can hand to programs right now (free + standby).">
        <StackPanel><TextBlock Text="FREE FOR PROGRAMS" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Available" Text="-- GB" Style="{StaticResource StatValue}" Foreground="{StaticResource Success}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="File cache held by Windows (reusable; counts toward Available).">
        <StackPanel ToolTip="Cached files and pages Windows can hand out instantly. It already counts as Available RAM. Deep reclaim empties it, which moves it to Free."><TextBlock Text="CACHE (READY TO REUSE)" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Cache" Text="-- GB" Style="{StaticResource StatValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="RAM nothing is using at all. It is normal for this to be small: Windows keeps spare RAM as cache instead.">
        <StackPanel ToolTip="Completely unused memory (what Resource Monitor calls Free). Available RAM = Free + Standby cache, so a big jump here after Deep reclaim is mostly cache moving over, not extra room."><TextBlock Text="COMPLETELY EMPTY" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Commit" Text="-- GB" Style="{StaticResource StatValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="Memory YUMRAM took back from idle programs last time. They get it back by themselves when they need it.">
        <StackPanel><TextBlock Text="TAKEN FROM IDLE APPS" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Potential" Text="-- MB" Style="{StaticResource StatValue}" Foreground="{StaticResource Brand}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" ToolTip="How much more RAM programs could use after the last Free RAM, measured after Windows settled (the real result).">
        <StackPanel><TextBlock Text="REAL GAIN LAST TIME" Style="{StaticResource StatLabel}"/><TextBlock x:Name="LastGain" Text="-- GB" Style="{StaticResource StatValue}" Foreground="{StaticResource Success}"/></StackPanel></Border>
    </UniformGrid>

    <!-- Body: results | actions -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="What the last reclaim did" Style="{StaticResource SectionTitle}" Margin="16,14,16,10"/>
          <ListView x:Name="Items" BorderThickness="0" Background="Transparent" Margin="1,0,1,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View><GridView>
              <GridViewColumn Header="Program or part of memory" DisplayMemberBinding="{Binding Process}" Width="200"/>
              <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="100"/>
              <GridViewColumn Header="Was using (MB)" DisplayMemberBinding="{Binding BeforeMB}" Width="104"/>
              <GridViewColumn Header="Freed (MB)" DisplayMemberBinding="{Binding ReducedMB}" Width="84"/>
              <GridViewColumn Header="Result" Width="104">
                <GridViewColumn.CellTemplate><DataTemplate>
                  <Border CornerRadius="3" Padding="8,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                    <TextBlock x:Name="ResultText" Text="{Binding Result}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Result}" Value="Completed"><Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Trimmed"><Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Failed"><Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Ready"><Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource Brand}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Why" Width="260"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
            </GridView></ListView.View>
          </ListView>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- Option 1 -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="any time" Style="{StaticResource Caption}" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
                <TextBlock Text="Free RAM now" Style="{StaticResource SectionTitle}" Margin="0"/></DockPanel>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Trims up to 12 idle, identified programs"/>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Moves the Windows file cache to standby *"/>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Writes out changed memory waiting in RAM *"/>
                  <TextBlock Style="{StaticResource Tick}" Text="✓  Merges identical memory pages (every 15 min) *"/>
              <TextBlock Style="{StaticResource Tick}" Text="No slowdown: nothing you are using is touched." Foreground="{StaticResource TextMuted}" Margin="0,6,0,10"/>
              <Button x:Name="FreeRam" Content="💜  Free RAM now" Style="{StaticResource PrimaryButton}" MinHeight="40"/>
            </StackPanel>
          </Border>
          <!-- Option 2 -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="biggest boost" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}" VerticalAlignment="Center"/>
                <TextBlock Text="Deep reclaim" Style="{StaticResource SectionTitle}" Margin="0"/></DockPanel>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Everything in Free RAM now, plus:"/>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Trims active programs too (up to 32)"/>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Empties every program's memory at once *"/>
              <TextBlock Style="{StaticResource Tick}" Text="✓  Clears the standby cache *"/>
                  <TextBlock Style="{StaticResource Tick}" Text="✓  Merges identical memory pages, every time *"/>
              <TextBlock Style="{StaticResource Tick}" Text="Programs may feel slower for a few seconds while they reload. Skipped parts while a game runs." Foreground="{StaticResource TextMuted}" Margin="0,6,0,10"/>
              <Button x:Name="DeepReclaim" Content="💜  Deep reclaim"/>
            </StackPanel>
          </Border>
          <TextBlock Text="* needs YUMRAM to run as administrator" Style="{StaticResource Caption}" Margin="4,0,0,12"/>
          <!-- Status + result -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Result" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="Activity" Text="Ready" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" Margin="0,0,0,10"/>
              <TextBlock x:Name="Measurement" Text="No reclaim run yet. The real gain is measured after Windows settles, then re-checked at 5, 15 and 30 seconds." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="3" Margin="2,10,2,0">
      <TextBlock DockPanel.Dock="Right" Text="No scan runs when this window opens." Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="16,0,0,0"/>
      <TextBlock x:Name="Footer" Text="Ready" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
