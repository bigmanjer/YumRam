<?xml version="1.0" encoding="utf-8"?>
<!--
  YUMRAM main window (5.6 one-window layout). Styles come from UI\Xaml\Theme.xaml (Application resources).
  Every x:Name below is referenced by UI\MainWindow.ps1 / UI\Shell.ps1; keep the names when changing the layout.
  Layout: left sidebar (pages + live RAM status, like Windows 11 Task Manager / Fluent NavigationView) ->
  content area. "Overview" is the dashboard below; every other page is hosted in PageHost by UI\Shell.ps1.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YUMRAM"
    Width="1440" Height="900" MinWidth="1060" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
    FontFamily="{StaticResource UiFont}" FontSize="14"
    ResizeMode="CanResize" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- Sidebar entry. Tag="Selected" marks the current page (accent bar + soft fill). -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"/>
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="2" Background="{StaticResource Accent}" Visibility="Collapsed"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="Tag" Value="Selected">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="220" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,12,10,12">
        <!-- Brand + collapse -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <Button x:Name="SidebarToggle" DockPanel.Dock="Left" Content="☰" Style="{StaticResource NavButton}" Padding="12,8" Margin="0" ToolTip="Show or hide page names" AutomationProperties.Name="Toggle sidebar"/>
          <StackPanel x:Name="SideBrand" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="YUMRAM" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brand}"/>
            <TextBlock x:Name="SideVersion" Text="memory care" Style="{StaticResource Caption}"/>
          </StackPanel>
        </DockPanel>

        <!-- Bottom: live status, settings, about -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="SideStatusPanel" Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
              <WrapPanel Margin="0,0,0,8">
                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" ToolTip="Current memory mode">
                  <TextBlock x:Name="Mode" Text="BALANCED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Pink}"/>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,0,0,4" ToolTip="Automatic monitoring state">
                  <TextBlock x:Name="Status" Text="● Paused" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                </Border>
              </WrapPanel>
              <TextBlock x:Name="SideRamText" Text="--% used • -- GB free" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <ProgressBar x:Name="SideRamBar" Maximum="100" Height="6" Foreground="{StaticResource SeriesMemory}"/>
              <!-- 5.15.2: an Intelligence scan / research is visible from every page -->
              <StackPanel x:Name="SideScanPanel" Visibility="Collapsed" Margin="0,10,0,0" Cursor="Hand" ToolTip="Intelligence is scanning or researching. Click to open it.">
                <TextBlock x:Name="SideScanText" Text="🔍 Scanning…" FontSize="11.5" FontWeight="SemiBold" Foreground="#C084FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                <ProgressBar x:Name="SideScanBar" Maximum="100" Height="6" Foreground="#C084FC"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SideRamCompact" Text="--%" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="Collapsed" ToolTip="RAM in use"/>
          <Button x:Name="Settings" Style="{StaticResource NavButton}" ToolTip="Settings (Ctrl+6)" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="24" TextAlignment="Center"/><TextBlock Text="Settings" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="About" Style="{StaticResource NavButton}" ToolTip="About YUMRAM (Ctrl+7)" AutomationProperties.Name="About">
            <StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" Width="24" TextAlignment="Center"/><TextBlock Text="About" Margin="10,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>

        <!-- Pages -->
        <StackPanel>
          <Button x:Name="NavOverview" Style="{StaticResource NavButton}" ToolTip="Overview: live RAM and CPU, goal and one-click reclaim (Ctrl+1)" AutomationProperties.Name="Overview">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" Width="24" TextAlignment="Center"/><TextBlock Text="Overview" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="Processes" Style="{StaticResource NavButton}" ToolTip="Every program using memory or CPU, explained in plain words. Updates live. (Ctrl+2)" AutomationProperties.Name="What's running">
            <StackPanel Orientation="Horizontal"><TextBlock Text="📊" Width="24" TextAlignment="Center"/><TextBlock Text="What's running" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="ReclaimCenter" Style="{StaticResource NavButton}" ToolTip="Run a reclaim and see exactly what was trimmed and what Windows returned. (Ctrl+3)" AutomationProperties.Name="Reclaim Center">
            <StackPanel Orientation="Horizontal"><TextBlock Text="♻" Width="24" TextAlignment="Center"/><TextBlock Text="Reclaim Center" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="Startup" Style="{StaticResource NavButton}" ToolTip="Programs that start with Windows: see what they cost in RAM and turn them off safely. (Ctrl+4)" AutomationProperties.Name="Startup apps">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🚀" Width="24" TextAlignment="Center"/><TextBlock Text="Startup apps" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="WindowsBloat" Style="{StaticResource NavButton}" ToolTip="Preinstalled Windows apps and ad, tip and suggestion settings - removed or turned off reversibly. (Ctrl+8)" AutomationProperties.Name="Windows bloat">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🧹" Width="24" TextAlignment="Center"/><TextBlock Text="Windows bloat" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="Intelligence" Style="{StaticResource NavButton}" ToolTip="Identify every program, service and app; unknown items are researched automatically. (Ctrl+5)" AutomationProperties.Name="Intelligence">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🧠" Width="24" TextAlignment="Center"/><TextBlock Text="Intelligence" Margin="10,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= Content ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Other pages are placed here by UI\Shell.ps1 -->
      <ContentControl x:Name="PageHost" Grid.Row="0" Visibility="Collapsed" Focusable="False"/>

      <!-- ================= Overview page ================= -->
      <Grid x:Name="OverviewPage" Grid.Row="0" Margin="20,16,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Overview" Style="{StaticResource AppTitle}"/>
            <TextBlock Text="What your PC is doing right now (top), what happened (left) and what you can do (right)." Style="{StaticResource Caption}"/>
          </StackPanel>
          <Button x:Name="MiniBarButton" DockPanel.Dock="Right" Content="▭ Mini bar" Style="{StaticResource GhostButton}" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Bottom"
                  ToolTip="Shrink YUMRAM to a small floating bar (RAM, CPU, GPU, disk) you can drag anywhere. Double-click it or press Open to come back."/>
          <TextBlock x:Name="HotkeyHint" DockPanel.Dock="Right" Text="" Style="{StaticResource Caption}" VerticalAlignment="Bottom"
                     ToolTip="Global shortcut for Free RAM now. Works even when YUMRAM is hidden in the tray. Change it in Settings."/>
        </DockPanel>

        <!-- 5.10: update banner (hidden until a verified update is available) -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" VerticalAlignment="Top">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="UpdateNotes" Content="What's new" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
              <Button x:Name="UpdateInstall" Content="Install and restart" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="UpdateTitle" Text="Update available" FontWeight="SemiBold"/>
              <TextBlock x:Name="UpdateText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 5.15.2 layout (user: "main page is cluttered and hard to understand"): the top row answers "what is my PC
             doing right now?" with four matching tiles (RAM, CPU, GPU, Disk: big number, one plain line, one bar).
             Below: the history graph on the left and everything you can DO on the right. Same controls as before. -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,-12,14">

          <!-- RAM -->
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="78" Height="78" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Share of physical RAM in use">
                <Ellipse x:Name="MemoryRingTrack" Stroke="{StaticResource SeriesMemory}" StrokeThickness="8" Opacity="0.22"/>
                <Path x:Name="MemoryRing" Stroke="{StaticResource SeriesMemory}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="used" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                  <TextBlock x:Name="MemoryRingText" Text="--%" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,-2"/>
                  <TextBlock x:Name="MemoryRingState" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top">
                    <TextBlock x:Name="TargetStatus" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                  </Border>
                  <TextBlock Text="RAM FREE" Style="{StaticResource StatLabel}" ToolTip="RAM programs can use right now (Windows calls it Available)."/>
                </DockPanel>
                <TextBlock x:Name="Available" Text="-- GB" Style="{StaticResource HeroValue}" FontSize="30" Margin="0,2,0,0"/>
                <TextBlock x:Name="Target" Text="" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ProgressBar x:Name="TargetBar" Maximum="100" Foreground="{StaticResource Success}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- CPU -->
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="78" Height="78" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Share of all CPU cores in use right now">
                <Ellipse x:Name="CpuRingTrack" Stroke="{StaticResource SeriesCpu}" StrokeThickness="8" Opacity="0.22"/>
                <Path x:Name="CpuRing" Stroke="{StaticResource SeriesCpu}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="busy" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                  <TextBlock x:Name="CpuRingText" Text="--%" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,-2"/>
                  <TextBlock x:Name="CpuRingState" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" ToolTip="What CPU care is doing (Settings › CPU)">
                    <TextBlock x:Name="CpuCareStatus" Text="--" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                  </Border>
                  <TextBlock Text="CPU" Style="{StaticResource StatLabel}"/>
                </DockPanel>
                <TextBlock x:Name="CpuSpeed" Text="-- GHz" Style="{StaticResource HeroValue}" FontSize="30" Foreground="{StaticResource Text}" Margin="0,2,0,0" ToolTip="Current speed of the processor (all cores), from Windows' processor performance counter"/>
                <TextBlock x:Name="CpuDetails" Text="-- processes • -- threads" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CpuBusiest" Text="" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- GPU -->
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,12"
                  ToolTip="Ring = how hard your graphics chip's 3D engine is working right now (games and 3D apps use it; the same number as Task Manager's GPU '3D' graph). VRAM = the graphics card's own memory in use out of its total. Laptops often have two graphics chips.">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="78" Height="78" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse x:Name="GpuRingTrack" Stroke="{StaticResource SeriesGpu}" StrokeThickness="8" Opacity="0.22"/>
                <Path x:Name="GpuRing" Stroke="{StaticResource SeriesGpu}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="busy" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                  <TextBlock x:Name="GPU" Text="--%" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,-2"/>
                  <TextBlock x:Name="GpuRingState" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="GRAPHICS (GPU)" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="GpuName" Text="--" Style="{StaticResource HeroValue}" FontSize="24" Foreground="{StaticResource Text}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="GpuVram" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Disk -->
          <Border x:Name="DiskCard" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,12"
                  ToolTip="Ring = how much of the time your disk is working (Task Manager calls it 'Active time'). Near 100 % for a long time means programs wait for the disk.">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="78" Height="78" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse x:Name="DiskRingTrack" Stroke="#7DD3FC" StrokeThickness="8" Opacity="0.22"/>
                <Path x:Name="DiskRing" Stroke="#7DD3FC" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="busy" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                  <TextBlock x:Name="DiskBusy" Text="--%" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,-2"/>
                  <TextBlock x:Name="DiskRingState" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="DISK" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="DiskFree" Text="-- GB" Style="{StaticResource HeroValue}" FontSize="24" Foreground="{StaticResource Text}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DiskSpaceText" Text="" Style="{StaticResource Caption}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <ProgressBar x:Name="DiskSpaceBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#7DD3FC"/>
                <TextBlock x:Name="DiskSpeed" Text="Read -- · Write --" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DiskDetail" Text="" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
          </Border>
        </UniformGrid>

        <!-- Body: graph (left) + what you can do (right) -->
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

          <!-- Live graph -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="GraphCaption" Text="last 30 seconds" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="Range30s" Content="30 s" Style="{StaticResource GhostButton}" Padding="8,2" ToolTip="Live: last 30 seconds"/>
                  <Button x:Name="Range5m" Content="5 min" Style="{StaticResource GhostButton}" Padding="8,2" ToolTip="Last 5 minutes"/>
                  <Button x:Name="Range1h" Content="1 h" Style="{StaticResource GhostButton}" Padding="8,2" ToolTip="Last hour"/>
                  <Button x:Name="Range12h" Content="12 h" Style="{StaticResource GhostButton}" Padding="8,2" ToolTip="Last 12 hours - kept across restarts as 1-minute averages"/>
                </StackPanel>
                <TextBlock Text="History" Style="{StaticResource SectionTitle}" Margin="0" ToolTip="Top: free RAM with your goal as a dashed line. Bottom: CPU and GPU. Both 0-100 %."/>
              </DockPanel>
              <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="8" ClipToBounds="True">
                <Canvas x:Name="Graph" Background="{StaticResource Bg}" SnapsToDevicePixels="True" ClipToBounds="True" Margin="6"/>
              </Border>
              <WrapPanel Grid.Row="2" Margin="0,10,0,10" HorizontalAlignment="Left">
                <TextBlock FontSize="11.5" Margin="0,0,16,0" Foreground="{StaticResource TextMuted}"><Run Text="● " Foreground="{StaticResource SeriesAvailable}"/><Run Text="Free RAM"/></TextBlock>
                <TextBlock FontSize="11.5" Margin="0,0,16,0" Foreground="{StaticResource TextMuted}"><Run Text="- - " Foreground="#FBBF24"/><Run Text="Your goal"/></TextBlock>
                <TextBlock FontSize="11.5" Margin="0,0,16,0" Foreground="{StaticResource TextMuted}"><Run Text="● " Foreground="{StaticResource SeriesCpu}"/><Run Text="CPU"/></TextBlock>
                <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}"><Run Text="● " Foreground="{StaticResource SeriesGpu}"/><Run Text="GPU"/></TextBlock>
              </WrapPanel>
              <StackPanel Grid.Row="3">
                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="Usage" DockPanel.Dock="Right" Text="-- / -- GB" Style="{StaticResource Caption}"/>
                  <TextBlock Text="RAM in use" Style="{StaticResource StatLabel}"/>
                </DockPanel>
                <ProgressBar x:Name="MemoryBar" Maximum="100" Foreground="{StaticResource SeriesMemory}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- What you can do -->
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <StackPanel Visibility="Collapsed"><TextBlock x:Name="Memory" Text="--%"/><TextBlock x:Name="CPU" Text="--%"/></StackPanel>

              <!-- Free RAM + automatic care -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="FREE UP RAM" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                  <Button x:Name="FreeRam" Content="Free RAM now" Style="{StaticResource PrimaryButton}" MinHeight="38"
                          ToolTip="Takes back memory that idle programs are not using. Protected programs, the window you are using and games are never touched."/>
                  <Button x:Name="DeepReclaim" Content="Deep reclaim" Margin="0,8,0,0"
                          ToolTip="Free RAM now, plus emptying Windows' memory cache (needs administrator). Programs may feel slower for a few seconds. Skipped while a game runs."/>
                  <TextBlock x:Name="ReclaimStatus" Text="Results are measured after Windows settles (about 2 s)." Style="{StaticResource Caption}" Margin="2,6,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                  <Separator Margin="0,12,0,10" Opacity="0.4"/>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                      <TextBlock x:Name="QuickMonitorStatus" Text="PAUSED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                    </Border>
                    <TextBlock Text="AUTOMATIC CARE" Style="{StaticResource StatLabel}" VerticalAlignment="Center" ToolTip="On: YUMRAM keeps free RAM above your goal by itself."/>
                  </DockPanel>
                  <Button x:Name="Monitor" Content="▶ Start Monitoring" Margin="0,6,0,0" FontWeight="SemiBold"
                          ToolTip="On: YUMRAM keeps free RAM above your goal automatically. Off: nothing happens automatically."/>
                  <TextBlock x:Name="QuickMonitorTelemetry" Text="" Style="{StaticResource Caption}" Margin="2,4,0,0" Visibility="Collapsed"/>
                  <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="Game" DockPanel.Dock="Right" Text="None" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    <TextBlock Text="GAME RUNNING" Style="{StaticResource StatLabel}" VerticalAlignment="Center" ToolTip="The game YUMRAM detected. It is protected while it runs."/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- 5.6: RAM freed by YUMRAM (measured Available gain, not trimmed working set) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12"
                      ToolTip="RAM YUMRAM actually gave back, measured after Windows settles. Memory that Windows immediately took back is not counted.">
                <StackPanel>
                  <TextBlock Text="RAM FREED BY YUMRAM" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="FreedToday" Text="0.0 GB" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesAvailable}"/>
                      <TextBlock x:Name="FreedTodayRuns" Text="today" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="FreedTotal" Text="0.0 GB" Style="{StaticResource StatValue}"/>
                      <TextBlock x:Name="FreedTotalRuns" Text="all time" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- 5.8/5.11: CPU care -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12"
                      ToolTip="When the PC is busy and a background program hogs the CPU, YUMRAM briefly lowers that program's priority so the app you are using stays smooth. It is put back as soon as it calms down. The app you are using and your game are never touched.">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <CheckBox x:Name="CpuBalanceToggle" DockPanel.Dock="Right" Content="On" VerticalAlignment="Center" AutomationProperties.Name="CPU balance"/>
                    <Border x:Name="CpuBalancePill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0,0,8,0" Visibility="Collapsed">
                      <TextBlock Text="ACTIVE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                    </Border>
                    <TextBlock x:Name="CpuCareTitle" Text="CPU CARE" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock x:Name="CpuBalanceText" Text="Starting…" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CpuBalanceCount" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- Memory goal -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Memory goal" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Keep at least this much RAM free (GB)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Margin="0,0,8,0" AutomationProperties.Name="Memory goal in gigabytes"/>
                    <Button x:Name="Apply" Grid.Column="1" Content="Apply" MinWidth="72"/>
                  </Grid>
                  <TextBlock Text="Mode" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                  <ComboBox x:Name="ModeBox" AutomationProperties.Name="Mode">
                    <ComboBoxItem Content="Safe — minimal intervention" Tag="Safe"/>
                    <ComboBoxItem Content="Balanced — recommended" Tag="Balanced"/>
                    <ComboBoxItem Content="Aggressive — maximum reclaim" Tag="Aggressive"/>
                  </ComboBox>
                  <TextBlock x:Name="ModeHelp" Text="Balanced: recommended." Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- Game protection -->
              <Expander Header="Game protection" IsExpanded="False" Margin="0,0,0,12">
                <StackPanel>
                  <CheckBox x:Name="AutoGame" Content="Detect games automatically"/>
                  <CheckBox x:Name="ProtectGame" Content="Never trim the active game"/>
                  <CheckBox x:Name="AutoClean" Content="Free RAM when a game starts"/>
                  <TextBlock Text="Game CPU priority" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                  <ComboBox x:Name="PriorityBox" AutomationProperties.Name="Game CPU priority">
                    <ComboBoxItem Content="Keep existing"/>
                    <ComboBoxItem Content="Normal (default)"/>
                    <ComboBoxItem Content="Above normal (game preference)"/>
                    <ComboBoxItem Content="High (advanced)"/>
                  </ComboBox>
                  <TextBlock Text="CPU scheduling only; this does not add RAM or GPU power." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- ================= Status bar ================= -->
      <DockPanel Grid.Row="1" Margin="22,8,22,10">
        <TextBlock x:Name="TelemetryStatus" DockPanel.Dock="Right" Text="Telemetry: --" Style="{StaticResource Caption}" Margin="16,0,0,0" TextWrapping="NoWrap"/>
        <TextBlock x:Name="VersionStatus" DockPanel.Dock="Right" Text="YUMRAM" Style="{StaticResource Caption}" TextWrapping="NoWrap"/>
        <TextBlock x:Name="Footer" Text="Ready" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Grid>

    <!-- 5.14: confirmation toast ("Settings applied", "Goal set to 6 GB"). Shown by Show-YumToast for ~3 s over
         every page; never takes clicks. -->
    <Border x:Name="Toast" Grid.ColumnSpan="9" Grid.RowSpan="9" Panel.ZIndex="100" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Padding="16,10"
            CornerRadius="10" Background="#2A1C3A" BorderBrush="#86EFAC" BorderThickness="1" Opacity="0" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastIcon" Text="✓" Foreground="#86EFAC" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Text="" Foreground="{StaticResource Text}" FontSize="13.5" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
