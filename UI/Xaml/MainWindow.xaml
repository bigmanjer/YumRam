<?xml version="1.0" encoding="utf-8"?>
<!--
  YUMRAM main window (5.4 layout). Styles come from UI\Xaml\Theme.xaml (Application resources).
  Every x:Name below is referenced by UI\MainWindow.ps1; keep the names when changing the layout.
  Layout: header -> top row (status + the two things people do: monitoring and reclaim) ->
  graph + side panel -> status bar. Designed to fit the 1000 x 700 minimum without clipping.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YUMRAM"
    Width="1180" Height="800" MinWidth="1000" MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
    FontFamily="{StaticResource UiFont}" FontSize="14"
    ResizeMode="CanResize" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Grid Margin="20,16,20,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= Header ================= -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="YUMRAM" Style="{StaticResource AppTitle}" VerticalAlignment="Center"/>
        <TextBlock Text="Memory reclaim &amp; monitor" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,5,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Pill}" Margin="0,0,8,0" ToolTip="Current memory mode">
          <TextBlock x:Name="Mode" Text="BALANCED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Pink}"/>
        </Border>
        <Border Style="{StaticResource Pill}" Margin="0,0,12,0" ToolTip="Automatic monitoring state">
          <TextBlock x:Name="Status" Text="● Paused" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
        </Border>
        <Button x:Name="Settings" Content="⚙  Settings" Style="{StaticResource GhostButton}"/>
        <Button x:Name="About" Content="About" Style="{StaticResource GhostButton}"/>
      </StackPanel>
    </DockPanel>

    <!-- ================= Top row: status + primary actions ================= -->
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="270"/>
      </Grid.ColumnDefinitions>

      <!-- Available RAM vs target -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- RAM-in-use ring (drawn by Update-YumMemoryRing in UI\MainWindow.ps1) -->
          <Grid Width="104" Height="104" Margin="0,0,20,0" VerticalAlignment="Center" ToolTip="Share of physical RAM in use">
            <Ellipse Stroke="{StaticResource Surface2}" StrokeThickness="10"/>
            <Path x:Name="MemoryRing" Stroke="{StaticResource SeriesMemory}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="MemoryRingText" Text="--%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="in use" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top">
                <TextBlock x:Name="TargetStatus" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
              </Border>
              <TextBlock Text="AVAILABLE RAM" Style="{StaticResource StatLabel}"/>
            </DockPanel>
            <TextBlock x:Name="Available" Grid.Row="1" Text="-- GB" Style="{StaticResource HeroValue}" Margin="0,2,0,2"/>
            <TextBlock x:Name="Target" Grid.Row="2" Text="Available: -- GB / Target: -- GB" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <ProgressBar x:Name="TargetBar" Grid.Row="3" Maximum="100" Foreground="{StaticResource Success}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Automatic care -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
              <TextBlock x:Name="QuickMonitorStatus" Text="PAUSED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
            </Border>
            <TextBlock Text="AUTOMATIC CARE" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
          </DockPanel>
          <Button x:Name="Monitor" Content="▶ Start Monitoring" MinHeight="40" FontWeight="SemiBold"
                  ToolTip="On: YUMRAM keeps Available RAM above your goal automatically. Off: nothing happens automatically."/>
          <TextBlock x:Name="QuickMonitorTelemetry" Text="Telemetry: --" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Reclaim now -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="RECLAIM NOW" Style="{StaticResource StatLabel}" Margin="0,0,0,10"/>
          <Button x:Name="FreeRam" Content="Free RAM now" Style="{StaticResource PrimaryButton}" MinHeight="40"
                  ToolTip="Trim idle, identified programs once. Protected programs, the active window and games are never touched."/>
          <Button x:Name="DeepReclaim" Content="Deep reclaim" Margin="0,8,0,0"
                  ToolTip="Free RAM now, plus flush and purge Windows memory lists (needs administrator). Skipped while a game runs."/>
          <TextBlock x:Name="ReclaimStatus" Text="Results are measured after Windows settles (about 2 s)." Style="{StaticResource Caption}" Margin="2,8,0,0" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= Body: graph + side panel ================= -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

      <!-- Live graph -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="last 30 seconds · 0–100%" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <TextBlock Text="Live memory" Style="{StaticResource SectionTitle}" Margin="0"/>
          </DockPanel>
          <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="8" ClipToBounds="True">
            <Canvas x:Name="Graph" Background="{StaticResource Bg}" SnapsToDevicePixels="True" ClipToBounds="True" Margin="6"/>
          </Border>
          <!-- Legend sits outside the canvas so it never covers the lines. -->
          <WrapPanel Grid.Row="2" Margin="0,10,0,10" HorizontalAlignment="Left">
            <TextBlock Text="● AVAILABLE RAM" Foreground="{StaticResource SeriesAvailable}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"/>
            <TextBlock Text="● MEMORY USED" Foreground="{StaticResource SeriesMemory}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"/>
            <TextBlock Text="● CPU" Foreground="{StaticResource SeriesCpu}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"/>
            <TextBlock Text="● GPU 3D" Foreground="{StaticResource SeriesGpu}" FontSize="11.5" FontWeight="SemiBold"/>
          </WrapPanel>
          <StackPanel Grid.Row="3">
            <DockPanel Margin="0,0,0,6">
              <TextBlock x:Name="Usage" DockPanel.Dock="Right" Text="-- / -- GB" Style="{StaticResource Caption}"/>
              <TextBlock Text="RAM in use" Style="{StaticResource StatLabel}"/>
            </DockPanel>
            <ProgressBar x:Name="MemoryBar" Maximum="100" Foreground="{StaticResource SeriesMemory}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Side panel -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- Quick stats -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
            <UniformGrid Columns="2" Rows="2">
              <StackPanel Margin="0,0,8,10"><TextBlock Text="MEMORY USED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Memory" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesMemory}"/></StackPanel>
              <StackPanel Margin="0,0,0,10"><TextBlock Text="CPU" Style="{StaticResource StatLabel}"/><TextBlock x:Name="CPU" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesCpu}"/></StackPanel>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="GPU 3D" Style="{StaticResource StatLabel}"/><TextBlock x:Name="GPU" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesGpu}"/></StackPanel>
              <StackPanel><TextBlock Text="GAME" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Game" Text="None" Style="{StaticResource StatValue}" FontSize="16" Margin="0,6,0,0" Foreground="{StaticResource SeriesAvailable}"/></StackPanel>
            </UniformGrid>
          </Border>

          <!-- Memory goal -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Memory goal" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Keep at least this much RAM available (GB)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox" Margin="0,0,8,0"/>
                <Button x:Name="Apply" Grid.Column="1" Content="Apply" MinWidth="72"/>
              </Grid>
              <TextBlock Text="Mode" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
              <ComboBox x:Name="ModeBox">
                <ComboBoxItem Content="Safe — minimal intervention" Tag="Safe"/>
                <ComboBoxItem Content="Balanced — recommended" Tag="Balanced"/>
                <ComboBoxItem Content="Aggressive — maximum reclaim" Tag="Aggressive"/>
              </ComboBox>
              <TextBlock x:Name="ModeHelp" Text="Balanced: recommended." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- Tools -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Tools" Style="{StaticResource SectionTitle}"/>
              <Button x:Name="Intelligence" Content="Intelligence &amp; research" HorizontalContentAlignment="Left"
                      ToolTip="Scan and identify every program, service and app; unknown items are researched automatically."/>
              <Button x:Name="ReclaimCenter" Content="RAM Reclaim Center" Margin="0,8,0,0"
                      ToolTip="Run a reclaim and see exactly what was trimmed and what Windows actually returned."/>
              <Button x:Name="Processes" Content="Top memory processes" Margin="0,8,0,0"
                      ToolTip="See which programs use the most RAM right now."/>
            </StackPanel>
          </Border>

          <!-- Game protection -->
          <Expander Header="Game protection" IsExpanded="False" Margin="0,0,0,12">
            <StackPanel>
              <CheckBox x:Name="AutoGame" Content="Detect games automatically"/>
              <CheckBox x:Name="ProtectGame" Content="Never trim the active game"/>
              <CheckBox x:Name="AutoClean" Content="Free RAM when a game starts"/>
              <TextBlock Text="Game CPU priority" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
              <ComboBox x:Name="PriorityBox">
                <ComboBoxItem Content="Keep existing"/>
                <ComboBoxItem Content="Normal (default)"/>
                <ComboBoxItem Content="Above normal (game preference)"/>
                <ComboBoxItem Content="High (advanced)"/>
              </ComboBox>
              <TextBlock Text="CPU scheduling only; this does not add RAM or GPU power." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================= Status bar ================= -->
    <DockPanel Grid.Row="3" Margin="2,10,2,0">
      <TextBlock x:Name="TelemetryStatus" DockPanel.Dock="Right" Text="Telemetry: --" Style="{StaticResource Caption}" Margin="16,0,0,0" TextWrapping="NoWrap"/>
      <TextBlock x:Name="VersionStatus" DockPanel.Dock="Right" Text="YUMRAM" Style="{StaticResource Caption}" TextWrapping="NoWrap"/>
      <TextBlock x:Name="Footer" Text="Ready" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
