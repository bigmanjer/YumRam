<?xml version="1.0" encoding="utf-8"?>
<!--
  YUMRAM main window (5.6 one-window layout). Styles come from UI\Xaml\Theme.xaml (Application resources).
  Every x:Name below is referenced by UI\MainWindow.ps1 / UI\Shell.ps1; keep the names when changing the layout.
  Layout: left sidebar (pages + live RAM status, like Windows 11 Task Manager / Fluent NavigationView) ->
  content area. "Overview" is the dashboard below; every other page is hosted in PageHost by UI\Shell.ps1.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YUMRAM"
    Width="1440" Height="900" MinWidth="1060" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
    FontFamily="{StaticResource UiFont}" FontSize="14"
    ResizeMode="CanResize" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- Sidebar entry. Tag="Selected" marks the current page (accent bar + soft fill). -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"/>
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="2" Background="{StaticResource Accent}" Visibility="Collapsed"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="Tag" Value="Selected">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="220" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,12,10,12">
        <!-- Brand + collapse -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <Button x:Name="SidebarToggle" DockPanel.Dock="Left" Content="☰" Style="{StaticResource NavButton}" Padding="12,8" Margin="0" ToolTip="Show or hide page names" AutomationProperties.Name="Toggle sidebar"/>
          <StackPanel x:Name="SideBrand" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="YUMRAM" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brand}"/>
            <TextBlock x:Name="SideVersion" Text="memory care" Style="{StaticResource Caption}"/>
          </StackPanel>
        </DockPanel>

        <!-- Bottom: live status, settings, about -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="SideStatusPanel" Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
              <WrapPanel Margin="0,0,0,8">
                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" ToolTip="Current memory mode">
                  <TextBlock x:Name="Mode" Text="BALANCED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Pink}"/>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,0,0,4" ToolTip="Automatic monitoring state">
                  <TextBlock x:Name="Status" Text="● Paused" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                </Border>
              </WrapPanel>
              <TextBlock x:Name="SideRamText" Text="--% used • -- GB free" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <ProgressBar x:Name="SideRamBar" Maximum="100" Height="6" Foreground="{StaticResource SeriesMemory}"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SideRamCompact" Text="--%" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="Collapsed" ToolTip="RAM in use"/>
          <Button x:Name="Settings" Style="{StaticResource NavButton}" ToolTip="Settings (Ctrl+6)" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="24" TextAlignment="Center"/><TextBlock Text="Settings" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="About" Style="{StaticResource NavButton}" ToolTip="About YUMRAM (Ctrl+7)" AutomationProperties.Name="About">
            <StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" Width="24" TextAlignment="Center"/><TextBlock Text="About" Margin="10,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>

        <!-- Pages -->
        <StackPanel>
          <Button x:Name="NavOverview" Style="{StaticResource NavButton}" ToolTip="Overview: live memory, goal and one-click reclaim (Ctrl+1)" AutomationProperties.Name="Overview">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" Width="24" TextAlignment="Center"/><TextBlock Text="Overview" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="Processes" Style="{StaticResource NavButton}" ToolTip="Every program using memory, explained in plain words. Updates live. (Ctrl+2)" AutomationProperties.Name="What's using RAM">
            <StackPanel Orientation="Horizontal"><TextBlock Text="📊" Width="24" TextAlignment="Center"/><TextBlock Text="What's using RAM" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="ReclaimCenter" Style="{StaticResource NavButton}" ToolTip="Run a reclaim and see exactly what was trimmed and what Windows returned. (Ctrl+3)" AutomationProperties.Name="Reclaim Center">
            <StackPanel Orientation="Horizontal"><TextBlock Text="♻" Width="24" TextAlignment="Center"/><TextBlock Text="Reclaim Center" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="Startup" Style="{StaticResource NavButton}" ToolTip="Programs that start with Windows: see what they cost in RAM and turn them off safely. (Ctrl+4)" AutomationProperties.Name="Startup apps">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🚀" Width="24" TextAlignment="Center"/><TextBlock Text="Startup apps" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="Intelligence" Style="{StaticResource NavButton}" ToolTip="Identify every program, service and app; unknown items are researched automatically. (Ctrl+5)" AutomationProperties.Name="Intelligence">
            <StackPanel Orientation="Horizontal"><TextBlock Text="🧠" Width="24" TextAlignment="Center"/><TextBlock Text="Intelligence" Margin="10,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= Content ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Other pages are placed here by UI\Shell.ps1 -->
      <ContentControl x:Name="PageHost" Grid.Row="0" Visibility="Collapsed" Focusable="False"/>

      <!-- ================= Overview page ================= -->
      <Grid x:Name="OverviewPage" Grid.Row="0" Margin="20,16,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Overview" Style="{StaticResource AppTitle}"/>
            <TextBlock Text="Live memory, your goal, and one-click reclaim." Style="{StaticResource Caption}"/>
          </StackPanel>
          <TextBlock x:Name="HotkeyHint" DockPanel.Dock="Right" Text="" Style="{StaticResource Caption}" VerticalAlignment="Bottom"
                     ToolTip="Global shortcut for Free RAM now. Works even when YUMRAM is hidden in the tray. Change it in Settings."/>
        </DockPanel>

        <!-- Top row: status + primary actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="270"/>
          </Grid.ColumnDefinitions>

          <!-- Available RAM vs target -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <!-- RAM-in-use ring (drawn by Update-YumMemoryRing in UI\MainWindow.ps1) -->
              <Grid Width="104" Height="104" Margin="0,0,20,0" VerticalAlignment="Center" ToolTip="Share of physical RAM in use">
                <Ellipse Stroke="{StaticResource Surface2}" StrokeThickness="10"/>
                <Path x:Name="MemoryRing" Stroke="{StaticResource SeriesMemory}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="MemoryRingText" Text="--%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="in use" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top">
                    <TextBlock x:Name="TargetStatus" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                  </Border>
                  <TextBlock Text="AVAILABLE RAM" Style="{StaticResource StatLabel}"/>
                </DockPanel>
                <TextBlock x:Name="Available" Grid.Row="1" Text="-- GB" Style="{StaticResource HeroValue}" Margin="0,2,0,2"/>
                <TextBlock x:Name="Target" Grid.Row="2" Text="Available: -- GB / Target: -- GB" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <ProgressBar x:Name="TargetBar" Grid.Row="3" Maximum="100" Foreground="{StaticResource Success}"/>
              </Grid>
            </Grid>
          </Border>

          <!-- Automatic care -->
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                  <TextBlock x:Name="QuickMonitorStatus" Text="PAUSED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                </Border>
                <TextBlock Text="AUTOMATIC CARE" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
              </DockPanel>
              <Button x:Name="Monitor" Content="▶ Start Monitoring" MinHeight="40" FontWeight="SemiBold"
                      ToolTip="On: YUMRAM keeps Available RAM above your goal automatically. Off: nothing happens automatically."/>
              <TextBlock x:Name="QuickMonitorTelemetry" Text="Telemetry: --" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- Reclaim now -->
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="RECLAIM NOW" Style="{StaticResource StatLabel}" Margin="0,0,0,10"/>
              <Button x:Name="FreeRam" Content="Free RAM now" Style="{StaticResource PrimaryButton}" MinHeight="40"
                      ToolTip="Trim idle, identified programs once. Protected programs, the active window and games are never touched."/>
              <Button x:Name="DeepReclaim" Content="Deep reclaim" Margin="0,8,0,0"
                      ToolTip="Free RAM now, plus flush and purge Windows memory lists (needs administrator). Skipped while a game runs."/>
              <TextBlock x:Name="ReclaimStatus" Text="Results are measured after Windows settles (about 2 s)." Style="{StaticResource Caption}" Margin="2,8,0,0" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Body: graph + side panel -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

          <!-- Live graph -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="last 30 seconds · 0–100%" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="Live memory" Style="{StaticResource SectionTitle}" Margin="0"/>
              </DockPanel>
              <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="8" ClipToBounds="True">
                <Canvas x:Name="Graph" Background="{StaticResource Bg}" SnapsToDevicePixels="True" ClipToBounds="True" Margin="6"/>
              </Border>
              <!-- Legend sits outside the canvas so it never covers the lines. -->
              <WrapPanel Grid.Row="2" Margin="0,10,0,10" HorizontalAlignment="Left">
                <TextBlock Text="● AVAILABLE RAM" Foreground="{StaticResource SeriesAvailable}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Text="● MEMORY USED" Foreground="{StaticResource SeriesMemory}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Text="● CPU" Foreground="{StaticResource SeriesCpu}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Text="● GPU 3D" Foreground="{StaticResource SeriesGpu}" FontSize="11.5" FontWeight="SemiBold"/>
              </WrapPanel>
              <StackPanel Grid.Row="3">
                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="Usage" DockPanel.Dock="Right" Text="-- / -- GB" Style="{StaticResource Caption}"/>
                  <TextBlock Text="RAM in use" Style="{StaticResource StatLabel}"/>
                </DockPanel>
                <ProgressBar x:Name="MemoryBar" Maximum="100" Foreground="{StaticResource SeriesMemory}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Side panel -->
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <!-- Quick stats -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
                <UniformGrid Columns="2" Rows="2">
                  <StackPanel Margin="0,0,8,10"><TextBlock Text="MEMORY USED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Memory" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesMemory}"/></StackPanel>
                  <StackPanel Margin="0,0,0,10"><TextBlock Text="CPU" Style="{StaticResource StatLabel}"/><TextBlock x:Name="CPU" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesCpu}"/></StackPanel>
                  <StackPanel Margin="0,0,8,0"><TextBlock Text="GPU 3D" Style="{StaticResource StatLabel}"/><TextBlock x:Name="GPU" Text="--%" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesGpu}"/></StackPanel>
                  <StackPanel><TextBlock Text="GAME" Style="{StaticResource StatLabel}"/><TextBlock x:Name="Game" Text="None" Style="{StaticResource StatValue}" FontSize="16" Margin="0,6,0,0" Foreground="{StaticResource SeriesAvailable}"/></StackPanel>
                </UniformGrid>
              </Border>

              <!-- 5.6: RAM freed by YUMRAM (measured Available gain, not trimmed working set) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12"
                      ToolTip="Available RAM YUMRAM actually gave back, measured after Windows settles. Trimmed memory that Windows immediately took back is not counted.">
                <StackPanel>
                  <TextBlock Text="RAM FREED BY YUMRAM" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock x:Name="FreedToday" Text="0.0 GB" Style="{StaticResource StatValue}" Foreground="{StaticResource SeriesAvailable}"/>
                      <TextBlock x:Name="FreedTodayRuns" Text="today" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="FreedTotal" Text="0.0 GB" Style="{StaticResource StatValue}"/>
                      <TextBlock x:Name="FreedTotalRuns" Text="all time" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- 5.8: CPU balance (ProBalance-style) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12"
                      ToolTip="When the PC is busy and a background program hogs the CPU, YUMRAM briefly lowers that program's priority so the app you are using stays smooth. It is put back as soon as it calms down. The app you are using and your game are never touched.">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <CheckBox x:Name="CpuBalanceToggle" DockPanel.Dock="Right" Content="On" VerticalAlignment="Center" AutomationProperties.Name="CPU balance"/>
                    <Border x:Name="CpuBalancePill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0,0,8,0" Visibility="Collapsed">
                      <TextBlock Text="ACTIVE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                    </Border>
                    <TextBlock Text="CPU BALANCE" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock x:Name="CpuBalanceText" Text="Starting…" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CpuBalanceCount" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- Memory goal -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Memory goal" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Keep at least this much RAM available (GB)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Margin="0,0,8,0" AutomationProperties.Name="Memory goal in gigabytes"/>
                    <Button x:Name="Apply" Grid.Column="1" Content="Apply" MinWidth="72"/>
                  </Grid>
                  <TextBlock Text="Mode" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                  <ComboBox x:Name="ModeBox" AutomationProperties.Name="Mode">
                    <ComboBoxItem Content="Safe — minimal intervention" Tag="Safe"/>
                    <ComboBoxItem Content="Balanced — recommended" Tag="Balanced"/>
                    <ComboBoxItem Content="Aggressive — maximum reclaim" Tag="Aggressive"/>
                  </ComboBox>
                  <TextBlock x:Name="ModeHelp" Text="Balanced: recommended." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <!-- Game protection -->
              <Expander Header="Game protection" IsExpanded="False" Margin="0,0,0,12">
                <StackPanel>
                  <CheckBox x:Name="AutoGame" Content="Detect games automatically"/>
                  <CheckBox x:Name="ProtectGame" Content="Never trim the active game"/>
                  <CheckBox x:Name="AutoClean" Content="Free RAM when a game starts"/>
                  <TextBlock Text="Game CPU priority" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                  <ComboBox x:Name="PriorityBox" AutomationProperties.Name="Game CPU priority">
                    <ComboBoxItem Content="Keep existing"/>
                    <ComboBoxItem Content="Normal (default)"/>
                    <ComboBoxItem Content="Above normal (game preference)"/>
                    <ComboBoxItem Content="High (advanced)"/>
                  </ComboBox>
                  <TextBlock Text="CPU scheduling only; this does not add RAM or GPU power." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- ================= Status bar ================= -->
      <DockPanel Grid.Row="1" Margin="22,8,22,10">
        <TextBlock x:Name="TelemetryStatus" DockPanel.Dock="Right" Text="Telemetry: --" Style="{StaticResource Caption}" Margin="16,0,0,0" TextWrapping="NoWrap"/>
        <TextBlock x:Name="VersionStatus" DockPanel.Dock="Right" Text="YUMRAM" Style="{StaticResource Caption}" TextWrapping="NoWrap"/>
        <TextBlock x:Name="Footer" Text="Ready" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
