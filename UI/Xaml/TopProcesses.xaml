<?xml version="1.0" encoding="utf-8"?>
<!--
  What's using my RAM (5.5). Names used by Show-YumTopProcesses in UI\Dialogs.ps1.
  Layout: header (live indicator + pause) -> summary cards -> list | "What is this?" panel -> footer.
  The list updates itself every 2 s (rows are updated in place, so the selection stays put).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - What's running" Width="1120" Height="740" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Answer" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="Question" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="Margin" Value="0,14,0,2"/></Style>
  </Window.Resources>
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="LivePill" Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock x:Name="LiveText" Text="● LIVE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
        </Border>
        <TextBlock Text="Sort by" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Button x:Name="SortRam" Content="RAM" Style="{StaticResource GhostButton}" FontWeight="SemiBold" ToolTip="Biggest memory users first."/>
        <Button x:Name="SortCpu" Content="CPU" Style="{StaticResource GhostButton}" Margin="0,0,10,0" ToolTip="Busiest programs first."/>
        <Button x:Name="Pause" Content="Pause" Style="{StaticResource GhostButton}" ToolTip="Stop the list from updating so it holds still."/>
        <Button x:Name="Refresh" Visibility="Collapsed" Content="Refresh"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="What's running" Style="{StaticResource AppTitle}"/>
        <TextBlock Text="Every program using memory or CPU right now. Click one to see what it is in plain words. Updates itself every 2 seconds." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <!-- Summary -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-8,12">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="RAM IN USE" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumUsed" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="AVAILABLE" Style="{StaticResource StatLabel}" Foreground="{StaticResource Success}"/><TextBlock x:Name="SumAvailable" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU NOW" Style="{StaticResource StatLabel}" Foreground="{StaticResource SeriesCpu}"/><TextBlock x:Name="SumCpu" Text="--" Style="{StaticResource StatValue}" FontSize="22"/><ProgressBar x:Name="SumCpuBar" Maximum="100" Height="4" Margin="0,4,0,4" Foreground="{StaticResource SeriesCpu}"/><TextBlock x:Name="SumCpuTop" Text="measuring…" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="PROGRAMS RUNNING" Style="{StaticResource StatLabel}" Foreground="{StaticResource Brand}"/><TextBlock x:Name="SumPrograms" Text="--" Style="{StaticResource StatValue}" FontSize="22"/><TextBlock x:Name="SumBiggest" Text="" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></StackPanel></Border>
    </UniformGrid>

    <!-- List | details -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <ListView x:Name="Items" BorderThickness="0" Background="Transparent" Margin="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.View><GridView>
            <GridViewColumn Header="Program" Width="260">
              <GridViewColumn.CellTemplate><DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Memory" Width="176">
              <GridViewColumn.CellTemplate><DataTemplate>
                <Grid Width="158">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding BarPercent, Mode=OneWay}" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="CPU" Width="132">
              <GridViewColumn.CellTemplate><DataTemplate>
                <Grid Width="114">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                  <ProgressBar x:Name="CpuBarCtl" Minimum="0" Maximum="100" Value="{Binding CpuBar, Mode=OneWay}" Height="6" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SeriesCpu}"/>
                  <TextBlock x:Name="CpuTextCtl" Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding CpuState}" Value="Held back"><Setter TargetName="CpuBarCtl" Property="Foreground" Value="{StaticResource Warning}"/><Setter TargetName="CpuTextCtl" Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Type" Width="108">
              <GridViewColumn.CellTemplate><DataTemplate>
                <Border CornerRadius="3" Padding="8,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                  <TextBlock x:Name="KindText" Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Windows"><Setter TargetName="KindText" Property="Foreground" Value="{StaticResource Info}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Security"><Setter TargetName="KindText" Property="Foreground" Value="{StaticResource Pink}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Hardware"><Setter TargetName="KindText" Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Game"><Setter TargetName="KindText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="App"><Setter TargetName="KindText" Property="Foreground" Value="{StaticResource Brand}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Unknown"><Setter TargetName="KindText" Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="What YUMRAM does" DisplayMemberBinding="{Binding YumText}" Width="130"/>
          </GridView></ListView.View>
        </ListView>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="WHAT IS THIS?" Style="{StaticResource StatLabel}"/>
            <TextBlock x:Name="ExplainTitle" Text="Click a program" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brand}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="ExplainSub" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExplainWhat" Text="Pick any program in the list and YUMRAM explains what it is, whether you can close it, and what YUMRAM does with it." Style="{StaticResource Answer}" Margin="0,10,0,0"/>
            <StackPanel x:Name="ExplainBody" Visibility="Collapsed">
              <TextBlock Text="HOW MUCH RAM?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainMemory" Style="{StaticResource Answer}"/>
              <TextBlock Text="HOW BUSY IS IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainCpu" Style="{StaticResource Answer}"/>
              <!-- 5.15.2: graphics memory (VRAM) this program holds, and moving it to the power-saving chip on 2-chip laptops -->
              <TextBlock Text="GRAPHICS MEMORY (VRAM)?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainVram" Style="{StaticResource Answer}" Text="Checking…"/>
              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="GpuSaver" Content="Use the power-saving graphics chip" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Windows' own per-app graphics setting (Settings > System > Display > Graphics). The program uses the built-in chip after it restarts, so its VRAM stays off your gaming chip. Undo is here too."/>
                <Button x:Name="GpuSaverUndo" Content="Undo" Style="{StaticResource GhostButton}" Padding="10,3" Visibility="Collapsed"/>
              </WrapPanel>
              <TextBlock Text="OUR ADVICE" Style="{StaticResource Question}"/>
              <Border x:Name="ExplainAdviceBadge" CornerRadius="3" Padding="10,3" HorizontalAlignment="Left" Background="{StaticResource Surface2}" BorderThickness="1"><TextBlock x:Name="ExplainAdviceLabel" Text="—" FontWeight="Bold" FontSize="13"/></Border>
              <TextBlock Text="CAN I CLOSE IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainSafe" Style="{StaticResource Answer}"/>
              <TextBlock Text="WHAT DOES YUMRAM DO WITH IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainYum" Style="{StaticResource Answer}"/>
              <TextBlock Text="WHERE IS IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainPath" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              <Button x:Name="OpenLocation" Content="📂  Show in File Explorer" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="Open the folder that contains this program, with the file selected."/>
              <TextBlock Text="YOUR RULES FOR IT" Style="{StaticResource Question}"/>
              <CheckBox x:Name="RuleNeverTrim" Content="Never trim this program" ToolTip="Free RAM now, Deep reclaim and automatic care will leave its memory alone."/>
              <CheckBox x:Name="RuleNeverHold" Content="Never hold back its CPU" Margin="0,6,0,0" ToolTip="CPU care will never lower its priority or move it off cores."/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="EndTask" Content="Close program…" Margin="0,0,8,0" Foreground="{StaticResource Danger}"
                ToolTip="Ask the selected program to close. YUMRAM asks you twice before forcing it, and never closes protected programs."/>
        <Button x:Name="Close" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      </StackPanel>
      <TextBlock x:Name="Details" Text="Updating every 2 seconds." Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
