<?xml version="1.0" encoding="utf-8"?>
<!-- Top memory processes (5.4 layout). Names used by Show-YumTopProcesses: Items, Details, Refresh, EndTask, Close. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Top memory processes" Width="860" Height="650" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Top memory processes" Style="{StaticResource AppTitle}"/>
      <TextBlock Text="Programs using the most RAM right now. Protected programs are never trimmed automatically." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <ListView x:Name="Items" BorderThickness="0" Background="Transparent" Margin="1">
        <ListView.View><GridView>
          <GridViewColumn Header="Process" DisplayMemberBinding="{Binding Process}" Width="260"/>
          <GridViewColumn Header="PID" DisplayMemberBinding="{Binding PID}" Width="80"/>
          <GridViewColumn Header="Memory MB" DisplayMemberBinding="{Binding MemoryMB}" Width="110"/>
          <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="130"/>
          <GridViewColumn Header="Protected" DisplayMemberBinding="{Binding ProtectedText}" Width="100"/>
        </GridView></ListView.View>
      </ListView>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="Refresh" Content="Refresh" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
        <Button x:Name="EndTask" Content="End task…" Margin="0,0,8,0" Foreground="{StaticResource Danger}"
                ToolTip="Ask the selected program to close. YUMRAM asks you twice before forcing it."/>
        <Button x:Name="Close" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      </StackPanel>
      <TextBlock x:Name="Details" Text="Select a process to see details." Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
