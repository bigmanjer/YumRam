<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="&#x1F4CA; Top Memory Processes" Width="860" Height="650" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#180D20" Foreground="#FFF7FF">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#9B5DE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="4"/></Style>
<Style TargetType="ListView"><Setter Property="Background" Value="#24152F"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#6A35A8"/></Style>
<Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="Padding" Value="6,4"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#6A35A8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#321B42"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="&#x1F4CA; Top Memory Processes" FontSize="22" FontWeight="Bold" Foreground="#CFA8FF"/><ListView x:Name="Items" Grid.Row="1" Margin="0,10"><ListView.View><GridView><GridViewColumn Header="Process" DisplayMemberBinding="{Binding Process}" Width="240"/><GridViewColumn Header="PID" DisplayMemberBinding="{Binding PID}" Width="70"/><GridViewColumn Header="Memory MB" DisplayMemberBinding="{Binding MemoryMB}" Width="100"/><GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="120"/><GridViewColumn Header="Protected" DisplayMemberBinding="{Binding Protected}" Width="90"/></GridView></ListView.View></ListView><DockPanel Grid.Row="2"><TextBlock x:Name="Details" Text="Select a process to see details." Foreground="#BFAFC9" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Refresh" Content="⟳ Refresh" Width="95"/><Button x:Name="EndTask" Content="⛔ End Task" Width="105"/><Button x:Name="Close" Content="Done" Width="90"/></StackPanel></DockPanel></Grid></Window>