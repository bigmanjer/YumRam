<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="🧹 Optional Background Cleanup" Width="1120" Height="720" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="🧹 Optional Background Cleanup" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Brand}" />
<Grid Grid.Row="1" Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox x:Name="Enable" Grid.Column="0" Content="Enable automatic optional-background cleanup" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Only approved apps are eligible. YUMRAM never force-kills optional background apps." Foreground="{StaticResource TextMuted}" Margin="18,2,18,0" VerticalAlignment="Center" TextWrapping="Wrap" /><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Scan" Content="🔎  Scan Background Apps" Width="190" MinWidth="190" /><Button x:Name="DoneTop" Content="Done" Width="80" /></StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="260" /><ColumnDefinition Width="1.6*" MinWidth="410" /><ColumnDefinition Width="1.15*" MinWidth="300" /></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Configured Apps" FontWeight="Bold" Foreground="{StaticResource Pink}" Margin="0,0,0,5" /><ListBox x:Name="Items" SelectionMode="Extended" MinHeight="390" /></StackPanel>
<StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="Discovered on this PC" FontWeight="Bold" Foreground="{StaticResource Brand}" Margin="0,0,0,5" /><ListView VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" x:Name="Discovered" SelectionMode="Extended" MinHeight="390"><ListView.View><GridView><GridViewColumn Header="Process" DisplayMemberBinding="{Binding Process}" Width="150" /><GridViewColumn Header="RAM MB" DisplayMemberBinding="{Binding MemoryMB}" Width="70" /><GridViewColumn Header="Publisher" DisplayMemberBinding="{Binding Publisher}" Width="150" /><GridViewColumn Header="Risk" DisplayMemberBinding="{Binding Risk}" Width="70" /><GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="220" /></GridView></ListView.View></ListView></StackPanel>
<StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Recommended Catalog" FontWeight="Bold" Foreground="{StaticResource Pink}" Margin="0,0,0,5" /><ListView VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" x:Name="Recommendations" SelectionMode="Extended" MinHeight="390"><ListView.View><GridView><GridViewColumn Header="App" DisplayMemberBinding="{Binding Name}" Width="120" /><GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="110" /><GridViewColumn Header="Risk" DisplayMemberBinding="{Binding Risk}" Width="65" /><GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="190" /></GridView></ListView.View></ListView></StackPanel>
</Grid>
<TextBlock x:Name="ScanStatus" Grid.Row="3" Text="Ready. Scan your PC to discover background candidates." Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,10,0,4" /><Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="Input" Height="36" VerticalContentAlignment="Center" Margin="0,0,6,0" /><Button x:Name="Add" Grid.Column="1" Content="＋ Add App" Width="100" Height="36" /><Button x:Name="AddDiscovered" Grid.Column="2" Content="＋ Add Selected" Width="115" Height="36" /><Button x:Name="AddRecommended" Grid.Column="3" Content="＋ Add Recommended" Width="135" Height="36" /><Button x:Name="Remove" Grid.Column="4" Content="− Remove" Width="105" Height="36" /><Button x:Name="Close" Grid.Column="5" Content="Done" Width="90" Height="36" /></Grid>
</Grid></Window>