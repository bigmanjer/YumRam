<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x1F50E; YUMRAM System Inventory" Width="1160" Height="740" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#180D20" Foreground="#FFF7FF">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#9B5DE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#9B5DE5"/><Setter Property="Margin" Value="4"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="#321B42" BorderBrush="#9B5DE5" BorderThickness="1" CornerRadius="8"><ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="#FFF7FF"/></Border><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#CFA8FF" Data="M 0 0 L 8 0 L 4 5 Z"/><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"><Border Background="#24152F" BorderBrush="#9B5DE5" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer CanContentScroll="False" MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="Background" Value="#321B42"/><Setter Property="Padding" Value="8,6"/><Setter Property="TextElement.Foreground" Value="#FFF7FF"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6A35A8"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#9B5DE5"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF7FF"/></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="#24152F"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="TextElement.Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#6A35A8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="Background" Value="#24152F"/><Setter Property="TextElement.Foreground" Value="#FFF7FF"/><Setter Property="Padding" Value="5,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#6A35A8"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0"><StackPanel><TextBlock Text="&#x1F50E; YUMRAM System Inventory" FontSize="23" FontWeight="Bold" Foreground="#CFA8FF"/><TextBlock Text="Task Manager-style live inventory with YUMRAM risk analysis." Foreground="#BFAFC9" Margin="0,3,0,0"/></StackPanel><Button x:Name="Close" DockPanel.Dock="Right" Content="Done" Width="90" Height="36"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" Grid.Column="0" Foreground="#BFAFC9" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Search:" Foreground="#BFAFC9" VerticalAlignment="Center" Margin="8,0,4,0"/><TextBox x:Name="Search" Width="190" Height="34" VerticalContentAlignment="Center" Margin="0,0,4,0" ToolTip="Process, publisher, path, or service name"/><TextBlock Text="Filter:" Foreground="#BFAFC9" VerticalAlignment="Center" Margin="8,0,4,0"/><ComboBox x:Name="Filter" Width="140"><ComboBoxItem Content="All Processes"/><ComboBoxItem Content="Low Risk"/><ComboBoxItem Content="Review"/><ComboBoxItem Content="Protected"/></ComboBox><Button x:Name="Refresh" Content="&#x27F3; Scan Now" Width="110" Height="34"/><Button x:Name="OrganizeSelected" Content="📁 Organize Selected" Width="135" Height="34"/></StackPanel></Grid>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="#24152F" BorderBrush="#6A35A8">
      <TabItem Header="Processes"><ListView x:Name="Processes" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"><ListView.View><GridView>
        <GridViewColumn Header="Process" DisplayMemberBinding="{Binding Process}" Width="165"/>
        <GridViewColumn Header="PID" DisplayMemberBinding="{Binding PID}" Width="65"/>
        <GridViewColumn Header="RAM MB" DisplayMemberBinding="{Binding MemoryMB}" Width="75"/>
        <GridViewColumn Header="CPU %" DisplayMemberBinding="{Binding CPU}" Width="65"/>
        <GridViewColumn Header="Parent PID" DisplayMemberBinding="{Binding ParentPID}" Width="80"/>
        <GridViewColumn Header="Session" DisplayMemberBinding="{Binding SessionId}" Width="60"/>
        <GridViewColumn Header="Publisher" DisplayMemberBinding="{Binding Publisher}" Width="170"/>
        <GridViewColumn Header="Risk" DisplayMemberBinding="{Binding Risk}" Width="85"/>
        <GridViewColumn Header="Placement" DisplayMemberBinding="{Binding Placement}" Width="145"/>
        <GridViewColumn Header="Research" DisplayMemberBinding="{Binding ResearchConfidence}" Width="75"/>
        <GridViewColumn Header="Score" DisplayMemberBinding="{Binding Score}" Width="60"/>
      </GridView></ListView.View></ListView></TabItem>
      <TabItem Header="Services"><ListView x:Name="Services" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"><ListView.View><GridView><GridViewColumn Header="Service" DisplayMemberBinding="{Binding Name}" Width="150"/><GridViewColumn Header="Display Name" DisplayMemberBinding="{Binding DisplayName}" Width="220"/><GridViewColumn Header="Start Mode" DisplayMemberBinding="{Binding StartMode}" Width="90"/><GridViewColumn Header="Can Stop" DisplayMemberBinding="{Binding CanStop}" Width="75"/><GridViewColumn Header="Dependents" DisplayMemberBinding="{Binding Dependents}" Width="85"/><GridViewColumn Header="Risk" DisplayMemberBinding="{Binding Risk}" Width="90"/><GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="300"/></GridView></ListView.View></ListView></TabItem>
      <TabItem Header="Apps"><ListView x:Name="Apps" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"><ListView.View><GridView><GridViewColumn Header="Package" DisplayMemberBinding="{Binding Name}" Width="240"/><GridViewColumn Header="Publisher" DisplayMemberBinding="{Binding PublisherId}" Width="250"/><GridViewColumn Header="Framework" DisplayMemberBinding="{Binding IsFramework}" Width="90"/><GridViewColumn Header="Package Full Name" DisplayMemberBinding="{Binding PackageFullName}" Width="380"/></GridView></ListView.View></ListView></TabItem>
      <TabItem Header="Startup"><ListView x:Name="Startup" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"><ListView.View><GridView><GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/><GridViewColumn Header="User" DisplayMemberBinding="{Binding Scope}" Width="120"/><GridViewColumn Header="Location" DisplayMemberBinding="{Binding Kind}" Width="180"/><GridViewColumn Header="Command" DisplayMemberBinding="{Binding Command}" Width="420"/><GridViewColumn Header="Placement" DisplayMemberBinding="{Binding Placement}" Width="150"/><GridViewColumn Header="Research" DisplayMemberBinding="{Binding Confidence}" Width="75"/></GridView></ListView.View></ListView></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ApproveSelected" Content="＋ Approve Selected" Width="135" Height="34"/><Button x:Name="ProtectSelected" Content="🛡 Protect Selected" Width="135" Height="34"/><Button x:Name="CloseBottom" Content="Done" Width="85" Height="34"/></StackPanel><TextBlock x:Name="Details" Foreground="#BFAFC9" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Unknown software is never automatically treated as bloat." Foreground="#806E8A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/></DockPanel>
  </Grid>
</Window>