<?xml version="1.0" encoding="utf-8"?>
<!-- About YUMRAM (5.7). Names used by Show-YumAbout: Version, HotkeyKeys, HotkeyText, OpenFolder, OpenLog, OpenProject, Close. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About YUMRAM" Width="700" Height="600" MinWidth="600" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="14,12"/></Style>
  </Window.Resources>
  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Accent}" Margin="0,0,14,0">
        <TextBlock Text="💜" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="YUMRAM" Style="{StaticResource AppTitle}"/>
        <TextBlock x:Name="Version" Text="Version" Style="{StaticResource Caption}"/>
        <TextBlock Text="Your ultimate memory reclaim &amp; monitor for Windows" Style="{StaticResource Caption}"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button x:Name="CheckUpdates" Content="⟳  Check for updates" Style="{StaticResource GhostButton}" Padding="8,3" ToolTip="Ask GitHub whether a newer YUMRAM release exists. Nothing about you or your PC is sent."/>
          <TextBlock x:Name="UpdateStatus" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="520"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <UniformGrid Columns="2" Margin="0,0,-10,0">
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="🎯  Keeps RAM free" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Set a goal and YUMRAM keeps that much RAM available, trimming idle programs only when needed."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="🛡  Safe by design" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Windows, security, drivers, your game and the app you are using are never trimmed."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="🧠  Knows your programs" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Identifies every process, service and app from Windows' own records, signatures and optional web research."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="📏  Honest numbers" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Every reclaim is measured after Windows settles and re-checked at 5, 15 and 30 seconds. The RAM freed counter only counts memory Windows really gave back."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="🚀  Startup apps" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="See what starts with Windows - programs, Store apps and sign-in tasks - and what it costs in RAM. Turning one off uses the same switch as Task Manager, so nothing is deleted."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="⚖  CPU care" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="When a background program hogs the CPU, YUMRAM lets the app or game you are using go first and gives it whole cores, checks that it helped, then puts everything back. Adapts to your CPU, laptop or desktop, battery or plugged in."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="🔒  Stays on your PC" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="No account and no telemetry. Settings and statistics live in the YUMRAM folder; nothing is sent unless you allow it (update check, online research, opt-in game results)."/></StackPanel></Border>
          <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="▣  One window" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Every tool is a page in the sidebar. Close the window to the tray and keep YUMRAM working in the background."/></StackPanel></Border>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Margin="0,4,0,10" Padding="14,12">
          <StackPanel>
            <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="HotkeyKeys" Text="Ctrl+Alt+R" FontWeight="SemiBold" Foreground="{StaticResource Brand}" Margin="0,0,0,6"/>
              <TextBlock x:Name="HotkeyText" Grid.Column="1" Text="Free RAM now, from anywhere (even from a game or the tray)" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="1" Text="Ctrl+1 … Ctrl+8" FontWeight="SemiBold" Foreground="{StaticResource Brand}" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Overview · What's running · Reclaim Center · Startup apps · Intelligence · Settings · About · Windows bloat (Ctrl+8)" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="2" Text="☰" FontWeight="SemiBold" Foreground="{StaticResource Brand}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="Show or hide the page names in the sidebar" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
        </Border>

        <Expander Header="Good to know" IsExpanded="False" Margin="0,0,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• Trimming moves memory a program is not using out of RAM; the program keeps running and pages it back in if it needs it."/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• Game priority changes CPU scheduling only. It does not add RAM or GPU power."/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• Run YUMRAM as administrator for the full reclaim (file cache, memory lists) and to change startup apps that start for all users."/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="• Settings, logs, statistics and learned data stay in the YUMRAM folder and are never uploaded. Online research (optional, in Settings) sends the name, publisher and product of programs YUMRAM cannot identify to Bing search and opens up to 4 trustworthy result pages to check the answer - nothing else."/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button x:Name="Close" DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="OpenFolder" Content="📂  YUMRAM folder" Style="{StaticResource GhostButton}" ToolTip="Open the folder with YUMRAM's settings, logs and learned data in File Explorer."/>
        <Button x:Name="OpenLog" Content="📄  Log" Style="{StaticResource GhostButton}" ToolTip="Open YUMRAM.log."/>
        <Button x:Name="OpenProject" Content="🌐  Project page" Style="{StaticResource GhostButton}" ToolTip="github.com/bigmanjer/YumRam"/>
        <Button x:Name="ReportProblem" Content="🐞  Report a problem" Style="{StaticResource GhostButton}" ToolTip="Opens GitHub's bug-report form in your browser, filled in with YUMRAM's version, your Windows version, CPU, RAM and the last lines of the log (your user name, PC name and user folder are removed). You can read and edit everything there; nothing is posted until you press Create."/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
