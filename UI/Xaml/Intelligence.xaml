<?xml version="1.0" encoding="utf-8"?>
<!--
  Intelligence Center (5.4 layout). Styles: UI\Xaml\Theme.xaml (ComboBox/ComboBoxItem templates with
  PART_Popup and TemplateBinding foreground live there). Every x:Name is used by Show-YumIntelligence in
  UI\Dialogs.ps1. Layout: header -> activity strip -> counters -> filter bar -> results + details -> status bar.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Intelligence" Width="1320" Height="880" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Counter" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="CounterValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}"><Setter Property="FontSize" Value="22"/></Style>
  </Window.Resources>
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="Refresh" Content="🔍  RUN SCAN" Style="{StaticResource PrimaryButton}" MinWidth="140" MinHeight="40" Margin="0,0,8,0"
                ToolTip="Scan this PC. Known items reuse saved knowledge; unresolved items are researched automatically."/>
        <Button x:Name="RunResearch" Visibility="Collapsed" Content="Automatic research" ToolTip="Automatic research is performed during Run Scan."/>
        <Button x:Name="Close" Content="Close" Style="{StaticResource GhostButton}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Intelligence Center" Style="{StaticResource AppTitle}"/>
        <TextBlock x:Name="OverviewMessage" Text="RUN SCAN identifies every process, service, app and startup item. Known items use saved knowledge; unresolved items are researched automatically." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        <TextBlock x:Name="DatabaseStatus" Text="Local profile • Waiting for first scan" Foreground="{StaticResource Success}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <!-- Activity strip -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ActivityStatus" Text="READY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock x:Name="ActivityDetail" Grid.Column="1" Text="No scan or research is running." Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
        <ProgressBar x:Name="ActivityProgress" Grid.Column="2" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Counters -->
    <UniformGrid Grid.Row="2" Columns="8" Margin="0,0,-8,12">
      <Border Style="{StaticResource Counter}" ToolTip="Items found by the last scan"><StackPanel><TextBlock Text="SCANNED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="ScannedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Waiting for research or your decision"><StackPanel><TextBlock Text="REVIEW" Style="{StaticResource StatLabel}" Foreground="{StaticResource Warning}"/><TextBlock x:Name="ReviewCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Being researched right now"><StackPanel><TextBlock Text="RESEARCHING" Style="{StaticResource StatLabel}" Foreground="{StaticResource Brand}"/><TextBlock x:Name="ResearchingCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Identified and organized"><StackPanel><TextBlock Text="RESOLVED" Style="{StaticResource StatLabel}" Foreground="{StaticResource Success}"/><TextBlock x:Name="ResolvedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Could not be identified; never managed automatically"><StackPanel><TextBlock Text="UNKNOWN" Style="{StaticResource StatLabel}"/><TextBlock x:Name="UnknownCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Windows, security, drivers and games; never trimmed"><StackPanel><TextBlock Text="PROTECTED" Style="{StaticResource StatLabel}" Foreground="{StaticResource Pink}"/><TextBlock x:Name="ProtectedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Resolved from saved knowledge without new research"><StackPanel><TextBlock Text="CACHED" Style="{StaticResource StatLabel}" Foreground="{StaticResource Info}"/><TextBlock x:Name="CachedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Research attempts that failed and will be retried"><StackPanel><TextBlock Text="ERRORS" Style="{StaticResource StatLabel}" Foreground="{StaticResource Danger}"/><TextBlock x:Name="ResearchErrorCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
    </UniformGrid>

    <!-- Filter bar -->
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Filter" ToolTip="Choose which items to show" Margin="0,0,8,0">
        <ComboBoxItem Content="Overview"/><ComboBoxItem Content="Review Queue"/><ComboBoxItem Content="Needs Research"/><ComboBoxItem Content="Researching"/><ComboBoxItem Content="Research Errors"/><ComboBoxItem Content="Cached / Knowledge"/><ComboBoxItem Content="Organized"/><ComboBoxItem Content="Unknown"/><ComboBoxItem Content="Protected"/><ComboBoxItem Content="Games"/><ComboBoxItem Content="Apps"/><ComboBoxItem Content="Services"/><ComboBoxItem Content="Startup"/><ComboBoxItem Content="Drivers / Hardware"/><ComboBoxItem Content="Processes"/><ComboBoxItem Content="All Items"/>
      </ComboBox>
      <TextBox x:Name="Search" Grid.Column="1" ToolTip="Search names, publishers, paths, categories or research notes"/>
      <TextBlock x:Name="ResearchProgress" Grid.Column="2" Text="Ready" Foreground="{StaticResource Brand}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
      <Button x:Name="RefreshView" Grid.Column="3" Content="↻  Reload" Style="{StaticResource GhostButton}"
              ToolTip="Reload the saved Intelligence database and merge it with the current scan, without scanning again."/>
    </Grid>

    <!-- Results + details -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <ListView x:Name="IntelligenceResults" Background="Transparent" BorderThickness="0" Margin="1" SelectionMode="Single"
                  ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True">
          <ListView.View><GridView>
            <GridViewColumn Header="Item" DisplayMemberBinding="{Binding Name}" Width="250"/>
            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="150"/>
            <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding Memory}" Width="80"/>
            <GridViewColumn Header="Risk" DisplayMemberBinding="{Binding Risk}" Width="100"/>
            <GridViewColumn Header="Research" DisplayMemberBinding="{Binding ResearchStatus}" Width="120"/>
            <GridViewColumn Header="Placement" DisplayMemberBinding="{Binding Placement}" Width="170"/>
            <GridViewColumn Header="Confidence" DisplayMemberBinding="{Binding ResearchConfidence}" Width="96"/>
          </GridView></ListView.View>
        </ListView>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Selected item" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="Details" Text="Select an item to see its classification, evidence and recommended action." TextWrapping="Wrap"/>
              <TextBlock Text="RECOMMENDED ACTION" Style="{StaticResource StatLabel}" Margin="0,12,0,4"/>
              <TextBlock x:Name="SelectedAction" Text="—" Foreground="{StaticResource Success}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Research" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="SelectedResearch" Text="Not selected" TextWrapping="Wrap"/>
              <Button x:Name="ResearchSelected" Content="Research this item" Margin="0,10,0,0" ToolTip="Research only the selected item now, ignoring cached results."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Your decision" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Choose a category for the selected item. It is saved and reused on future scans." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <ComboBox x:Name="ManualCategory" SelectedIndex="0">
                <ComboBoxItem Content="Games / Gaming"/><ComboBoxItem Content="User Background Apps"/><ComboBoxItem Content="Identified Applications"/><ComboBoxItem Content="Security"/><ComboBoxItem Content="Drivers / Hardware"/><ComboBoxItem Content="Startup Inventory"/><ComboBoxItem Content="Review Queue"/><ComboBoxItem Content="Unknown / Quarantine"/>
              </ComboBox>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ApplyOrganization" Content="Apply &amp; save" Style="{StaticResource PrimaryButton}" ToolTip="Save this category for the selected item."/>
                <Button x:Name="ClearOrganization" Grid.Column="2" Content="Reset" ToolTip="Remove your decision and return the item to Review."/>
              </Grid>
              <TextBlock x:Name="ManualOrganizationStatus" Text="No manual override selected." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Expander Header="How Intelligence works" IsExpanded="False">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="RUN SCAN builds the live inventory and researches anything it cannot identify. Local evidence (signatures, installed software, services, Store packages, WinGet) is used first; online search only corroborates. Your decisions are saved and reused. Saved records stay visible after a scan finishes."/>
              <TextBlock x:Name="Summary" Text="Saved knowledge refreshes live. Use Reload to re-read the database without scanning." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="5" Margin="2,10,2,0">
      <TextBlock x:Name="DatabaseCount" DockPanel.Dock="Right" Text="0 saved records" Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="16,0,0,0"/>
      <TextBlock x:Name="LastScan" Text="Not scanned yet" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
