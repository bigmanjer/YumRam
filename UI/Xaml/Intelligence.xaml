<?xml version="1.0" encoding="utf-8"?>
<!--
  Intelligence Center (5.4 layout). Styles: UI\Xaml\Theme.xaml (ComboBox/ComboBoxItem templates with
  PART_Popup and TemplateBinding foreground live there). Every x:Name is used by Show-YumIntelligence in
  UI\Dialogs.ps1.

  Layout (one place for each kind of information, read top to bottom):
    header (what this is + the one primary action)
    activity strip (the only live status line)
    summary cards (click one to filter the list; the active one is outlined)
    filter bar (Show + search + result count + reload)
    list | details (list/details pattern: select on the left, evidence and decisions on the right)
    status bar (saved profile, last scan)
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Intelligence" Width="1320" Height="880" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Counter" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Surface2}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CounterValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}"><Setter Property="FontSize" Value="22"/></Style>
    <Style x:Key="PanelLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="Margin" Value="0,14,0,4"/></Style>
    <Style x:Key="DisabledFade" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="Refresh" Content="🔍  RUN SCAN" Style="{StaticResource PrimaryButton}" MinWidth="140" MinHeight="40" Margin="0,0,8,0"
                ToolTip="Scan this PC. Known items reuse saved knowledge; unresolved items are researched automatically."/>
        <Button x:Name="RunResearch" Visibility="Collapsed" Content="Automatic research" ToolTip="Automatic research is performed during Run Scan."/>
        <Button x:Name="Close" Content="Close" Style="{StaticResource GhostButton}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Intelligence Center" Style="{StaticResource AppTitle}"/>
        <TextBlock x:Name="OverviewMessage" Text="Identifies every process, service, app and startup item so YUMRAM knows what is safe to trim. Known items use saved knowledge; the rest are researched automatically." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <!-- Activity strip: the only live status line -->
    <!-- 5.15.2 (user report: the scan was hard to notice): big status, what is being looked at, full-width bar.
         Outlined in the brand colour while a scan or research runs (Update-YumIntelligenceActivityLook). -->
    <Border x:Name="ActivityCard" Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <TextBlock x:Name="ActivityPercent" DockPanel.Dock="Right" Text="" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brand}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ActivityStatus" Text="READY" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ActivityDetail" Grid.Row="1" Text="No scan or research is running." FontSize="14" Foreground="{StaticResource Text}" TextWrapping="Wrap" MaxHeight="44" Margin="0,4,0,8"/>
        <ProgressBar x:Name="ActivityProgress" Grid.Row="2" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" Height="14"/>
      </Grid>
    </Border>

    <!-- Summary cards: Tag = the Show filter each card applies when clicked -->
    <UniformGrid x:Name="CounterStrip" Grid.Row="2" Columns="8" Margin="0,0,-8,12">
      <Border Style="{StaticResource Counter}" Tag="All Items" ToolTip="Everything YUMRAM knows about on this PC (running now and saved). Click to show all."><StackPanel><TextBlock Text="ALL ITEMS" Style="{StaticResource StatLabel}"/><TextBlock x:Name="ScannedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Organized" ToolTip="YUMRAM knows what these are. Click to show them."><StackPanel><TextBlock Text="IDENTIFIED" Style="{StaticResource StatLabel}" Foreground="{StaticResource Success}"/><TextBlock x:Name="ResolvedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Protected" ToolTip="Windows, security, drivers and games. YUMRAM never touches these. Click to show them."><StackPanel><TextBlock Text="NEVER TOUCHED" Style="{StaticResource StatLabel}" Foreground="{StaticResource Pink}"/><TextBlock x:Name="ProtectedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Review Queue" ToolTip="Not looked up yet. Run Scan checks them for you. Click to show them."><StackPanel><TextBlock Text="NOT CHECKED YET" Style="{StaticResource StatLabel}" Foreground="{StaticResource Warning}"/><TextBlock x:Name="ReviewCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Unknown" ToolTip="Could not be identified. YUMRAM leaves them alone; use Look it up online or Open file location to check them. Click to show them."><StackPanel><TextBlock Text="NOT IDENTIFIED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="UnknownCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Researching" ToolTip="Being looked up right now. Click to show them."><StackPanel><TextBlock Text="CHECKING NOW" Style="{StaticResource StatLabel}" Foreground="{StaticResource Brand}"/><TextBlock x:Name="ResearchingCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Cached / Knowledge" ToolTip="Recognised from what YUMRAM already learned, so no new lookup was needed. Click to show them."><StackPanel><TextBlock Text="ALREADY KNOWN" Style="{StaticResource StatLabel}" Foreground="{StaticResource Info}"/><TextBlock x:Name="CachedCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
      <Border Style="{StaticResource Counter}" Tag="Research Errors" ToolTip="The lookup did not work this time (for example no internet). They are tried again next scan. Click to show them."><StackPanel><TextBlock Text="WILL RETRY" Style="{StaticResource StatLabel}" Foreground="{StaticResource Danger}"/><TextBlock x:Name="ResearchErrorCount" Text="--" Style="{StaticResource CounterValue}"/></StackPanel></Border>
    </UniformGrid>

    <!-- Filter bar -->
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Show" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0"/>
      <ComboBox x:Name="Filter" Grid.Column="1" ToolTip="Choose which items to show" Margin="0,0,8,0">
        <ComboBoxItem Content="Overview"/><ComboBoxItem Content="Review Queue"/><ComboBoxItem Content="Needs Research"/><ComboBoxItem Content="Researching"/><ComboBoxItem Content="Research Errors"/><ComboBoxItem Content="Cached / Knowledge"/><ComboBoxItem Content="Organized"/><ComboBoxItem Content="Unknown"/><ComboBoxItem Content="Protected"/><ComboBoxItem Content="Games"/><ComboBoxItem Content="Apps"/><ComboBoxItem Content="Services"/><ComboBoxItem Content="Startup"/><ComboBoxItem Content="Drivers / Hardware"/><ComboBoxItem Content="Processes"/><ComboBoxItem Content="All Items"/>
      </ComboBox>
      <Grid Grid.Column="2">
        <TextBox x:Name="Search" ToolTip="Search names, publishers, categories or research notes"/>
        <TextBlock Text="🔎  Search by name, publisher, category or notes" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="13">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <TextBlock x:Name="ResultCount" Grid.Column="3" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,6,0" MinWidth="80" TextAlignment="Right"/>
      <TextBlock x:Name="ResearchProgress" Grid.Column="3" Text="Ready" Visibility="Collapsed"/>
      <Button x:Name="RefreshView" Grid.Column="4" Content="↻  Reload" Style="{StaticResource GhostButton}"
              ToolTip="Reload the saved Intelligence database and merge it with the current scan, without scanning again."/>
    </Grid>

    <!-- List | details -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <ListView x:Name="IntelligenceResults" Background="Transparent" BorderThickness="0" Margin="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True">
          <ListView.View><GridView>
            <GridViewColumn Header="Item" DisplayMemberBinding="{Binding Name}" Width="210"/>
            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Source}" Width="72"/>
            <GridViewColumn Header="Publisher" DisplayMemberBinding="{Binding Publisher}" Width="150"/>
            <GridViewColumn Header="Kind" Width="160">
              <GridViewColumn.CellTemplate><DataTemplate>
                <TextBlock x:Name="CatText" Text="{Binding Category}" TextTrimming="CharacterEllipsis"/>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Category}" Value="Identified Applications"><Setter TargetName="CatText" Property="Text" Value="App"/></DataTrigger>
                  <DataTrigger Binding="{Binding Category}" Value="User Background Apps"><Setter TargetName="CatText" Property="Text" Value="Background app"/></DataTrigger>
                  <DataTrigger Binding="{Binding Category}" Value="Protected"><Setter TargetName="CatText" Property="Text" Value="Part of Windows"/></DataTrigger>
                  <DataTrigger Binding="{Binding Category}" Value="Unknown / Quarantine"><Setter TargetName="CatText" Property="Text" Value="Not identified"/></DataTrigger>
                  <DataTrigger Binding="{Binding Category}" Value="Unknown"><Setter TargetName="CatText" Property="Text" Value="Not identified"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Our advice" Width="120">
              <GridViewColumn.CellTemplate><DataTemplate>
                <Border x:Name="Pill" CornerRadius="9" Padding="8,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                  <TextBlock x:Name="PillText" Text="Your call" FontSize="12" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Risk}" Value="Candidate"><Setter TargetName="PillText" Property="Text" Value="Turn off is fine"/><Setter TargetName="PillText" Property="Foreground" Value="#4ADE80"/></DataTrigger>
                  <DataTrigger Binding="{Binding Risk}" Value="Safe"><Setter TargetName="PillText" Property="Text" Value="Turn off is fine"/><Setter TargetName="PillText" Property="Foreground" Value="#4ADE80"/></DataTrigger>
                  <DataTrigger Binding="{Binding Risk}" Value="Safe to Manage"><Setter TargetName="PillText" Property="Text" Value="Turn off is fine"/><Setter TargetName="PillText" Property="Foreground" Value="#4ADE80"/></DataTrigger>
                  <DataTrigger Binding="{Binding Advice}" Value="YourCall"><Setter TargetName="PillText" Property="Text" Value="Your call"/><Setter TargetName="PillText" Property="Foreground" Value="#7DD3FC"/></DataTrigger>
                  <DataTrigger Binding="{Binding Risk}" Value="Protected"><Setter TargetName="PillText" Property="Text" Value="Keep"/><Setter TargetName="PillText" Property="Foreground" Value="#F9A8D4"/></DataTrigger>
                  <DataTrigger Binding="{Binding Advice}" Value="Keep"><Setter TargetName="PillText" Property="Text" Value="Keep"/><Setter TargetName="PillText" Property="Foreground" Value="#F9A8D4"/></DataTrigger>
                  <DataTrigger Binding="{Binding Advice}" Value="Game"><Setter TargetName="PillText" Property="Text" Value="Keep"/><Setter TargetName="PillText" Property="Foreground" Value="#F9A8D4"/></DataTrigger>
                  <DataTrigger Binding="{Binding Category}" Value="Games / Gaming"><Setter TargetName="PillText" Property="Text" Value="Keep"/><Setter TargetName="PillText" Property="Foreground" Value="#F9A8D4"/></DataTrigger>
                  <DataTrigger Binding="{Binding Category}" Value="Unknown / Quarantine"><Setter TargetName="PillText" Property="Text" Value="Careful"/><Setter TargetName="PillText" Property="Foreground" Value="#F87171"/></DataTrigger>
                  <DataTrigger Binding="{Binding Risk}" Value="Unknown"><Setter TargetName="PillText" Property="Text" Value="Careful"/><Setter TargetName="PillText" Property="Foreground" Value="#F87171"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Checked?" Width="110">
              <GridViewColumn.CellTemplate><DataTemplate>
                <TextBlock x:Name="StText" Text="{Binding ResearchStatus}"/>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ResearchStatus}" Value="Organized"><Setter TargetName="StText" Property="Text" Value="Identified"/></DataTrigger>
                  <DataTrigger Binding="{Binding ResearchStatus}" Value="Review"><Setter TargetName="StText" Property="Text" Value="Not checked yet"/></DataTrigger>
                  <DataTrigger Binding="{Binding ResearchStatus}" Value="Unknown"><Setter TargetName="StText" Property="Text" Value="Not identified"/></DataTrigger>
                  <DataTrigger Binding="{Binding ResearchStatus}" Value="Research Error"><Setter TargetName="StText" Property="Text" Value="Will retry"/></DataTrigger>
                  <DataTrigger Binding="{Binding ResearchStatus}" Value="Researching"><Setter TargetName="StText" Property="Text" Value="Checking now"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding Memory}" Width="58"/>
          </GridView></ListView.View>
        </ListView>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
          <!-- 1. What it is and what YUMRAM will do -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="SELECTED ITEM" Style="{StaticResource StatLabel}"/>
              <TextBlock x:Name="SelectedName" Text="Nothing selected" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brand}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock x:Name="SelectedMeta" Text="Select an item in the list to see what it is, the evidence and what YUMRAM will do with it." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock Text="WHAT IS IT FOR?" Style="{StaticResource PanelLabel}"/>
              <TextBlock x:Name="SelectedPurpose" Text="—" TextWrapping="Wrap"/>
              <TextBlock Text="WHAT YUMRAM WILL DO" Style="{StaticResource PanelLabel}"/>
              <TextBlock x:Name="SelectedAction" Text="—" Foreground="{StaticResource Success}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <!-- 5.15.2: one clear piece of advice (Keep / Your call / Turn off is fine / Careful) + where the file is -->
              <TextBlock Text="OUR ADVICE" Style="{StaticResource PanelLabel}"/>
              <Border x:Name="SelectedAdviceBadge" CornerRadius="9" Padding="10,3" HorizontalAlignment="Left" Background="{StaticResource Surface2}">
                <TextBlock x:Name="SelectedAdvice" Text="—" FontWeight="Bold" FontSize="13"/>
              </Border>
              <TextBlock x:Name="SelectedAdviceWhy" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="OpenLocation" Content="📂  Open file location" Margin="0,0,8,6" IsEnabled="False" ToolTip="Show this program's file in File Explorer."/>
                <Button x:Name="SearchOnline" Content="🌐  Look it up online" Margin="0,0,0,6" IsEnabled="False" ToolTip="Search the web for this name and publisher in your browser."/>
              </WrapPanel>
              <Expander Header="Evidence (details)" IsExpanded="False" Margin="0,12,0,0">
                <TextBlock x:Name="Details" Text="—" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              </Expander>
            </StackPanel>
          </Border>
          <!-- 2. Research -->
          <Border x:Name="ResearchCard" Style="{StaticResource DisabledFade}" IsEnabled="False">
            <StackPanel>
              <TextBlock Text="Research" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="SelectedResearch" Text="Not selected" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              <Button x:Name="ResearchSelected" Content="Research this item again" Margin="0,10,0,0" ToolTip="Research only the selected item now, ignoring cached results."/>
            </StackPanel>
          </Border>
          <!-- 3. Your decision -->
          <Border x:Name="DecisionCard" Style="{StaticResource DisabledFade}" IsEnabled="False">
            <StackPanel>
              <TextBlock Text="Your decision" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Override the category. Saved and reused on future scans." Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <ComboBox x:Name="ManualCategory" SelectedIndex="-1">
                <ComboBoxItem Content="Games / Gaming"/><ComboBoxItem Content="User Background Apps"/><ComboBoxItem Content="Identified Applications"/><ComboBoxItem Content="Security"/><ComboBoxItem Content="Drivers / Hardware"/><ComboBoxItem Content="Startup Inventory"/><ComboBoxItem Content="Review Queue"/><ComboBoxItem Content="Unknown / Quarantine"/>
              </ComboBox>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ApplyOrganization" Content="Apply &amp; save" Style="{StaticResource PrimaryButton}" ToolTip="Save this category for the selected item."/>
                <Button x:Name="ClearOrganization" Grid.Column="2" Content="Reset" ToolTip="Remove your decision and return the item to Review."/>
              </Grid>
              <TextBlock x:Name="ManualOrganizationStatus" Text="No manual override." Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Expander Header="How Intelligence works" IsExpanded="False">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="RUN SCAN builds the live inventory and researches anything it cannot identify. Local evidence (signatures, installed software, services, Store packages, WinGet) is used first; online search only corroborates. Your decisions are saved and reused. Saved records stay visible after a scan finishes. Click a summary card to filter the list."/>
              <TextBlock x:Name="Summary" Text="Saved knowledge refreshes live. Use Reload to re-read the database without scanning." Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="5" Margin="2,10,2,0">
      <TextBlock x:Name="DatabaseCount" DockPanel.Dock="Right" Text="0 saved records" Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="16,0,0,0"/>
      <TextBlock x:Name="LastScan" DockPanel.Dock="Right" Text="Not scanned yet" Style="{StaticResource Caption}" TextWrapping="NoWrap" Margin="16,0,0,0"/>
      <TextBlock x:Name="DatabaseStatus" Text="Local profile • Waiting for first scan" Style="{StaticResource Caption}" Foreground="{StaticResource Success}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
