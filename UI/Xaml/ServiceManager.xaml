<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="&#x2699; Optional Windows Services" Width="980" Height="680" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#180D20" Foreground="#FFF7FF">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#9B5DE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="4"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#24152F"/><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="BorderBrush" Value="#6A35A8"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="TextElement.Foreground" Value="#FFF7FF"/><Setter Property="Padding" Value="7,5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#6A35A8"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#321B42"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="&#x2699; Optional Windows Services" FontSize="22" FontWeight="Bold" Foreground="#CFA8FF"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10"><CheckBox x:Name="Enable" Content="Enable approved optional-service cleanup" IsChecked="False" Foreground="#FFF7FF" VerticalAlignment="Center"/><Button x:Name="RefreshServices" Content="Refresh Current Services" Width="170" Height="34"/><Button x:Name="ApproveSelected" Content="Add Selected to Approved" Width="180" Height="34"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Header="Approved Services" Foreground="#CFA8FF" Margin="0,0,8,0"><ListBox x:Name="Items" SelectionMode="Extended"/></GroupBox><GroupBox Grid.Column="1" Header="Current Stoppable / Review Services" Foreground="#CFA8FF" Margin="8,0,0,0"><ListBox x:Name="Available" SelectionMode="Extended"/></GroupBox></Grid>
<Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Input" Height="36" VerticalContentAlignment="Center" Margin="0,0,6,0"/><Button x:Name="Add" Grid.Column="1" Content="＋ Add Service" Width="110" Height="36"/><Button x:Name="Remove" Grid.Column="2" Content="− Remove" Width="110" Height="36"/></Grid>
<DockPanel Grid.Row="4" Margin="0,10,0,0"><TextBlock x:Name="Status" Text="Dependents are skipped; startup type is never changed." Foreground="#806E8A" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="Close" DockPanel.Dock="Right" Content="Done" Width="90"/></DockPanel>
</Grid></Window>