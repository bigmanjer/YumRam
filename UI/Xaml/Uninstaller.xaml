<?xml version="1.0" encoding="utf-8"?>
<!--
  Uninstall programs (5.17.0). Names used by Show-YumUninstaller in UI\UninstallerPage.ps1.
  Layout: header -> summary cards -> list | "What is it?" / leftovers panel -> footer.
  Uninstalling runs the program's own uninstaller; leftovers go to the Recycle Bin (registry: .reg backup first).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Uninstall programs" Width="1140" Height="760" MinWidth="920" MinHeight="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Answer" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="Question" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="Margin" Value="0,14,0,2"/></Style>
  </Window.Resources>
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Border x:Name="AdminPill" Style="{StaticResource Pill}" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="AdminText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
        </Border>
        <Button x:Name="Reload" Content="↻  Check again" Style="{StaticResource GhostButton}" ToolTip="Read the list of installed programs again."/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Uninstall programs" Style="{StaticResource AppTitle}"/>
        <TextBlock Text="Every program and Store app installed on this PC. Uninstall runs the program's own uninstaller (the same one Settings &gt; Apps uses); afterwards YUMRAM finds what it left behind. Leftovers go to the Recycle Bin and registry entries are backed up first, so nothing is lost for good." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"><Run Text="Our advice:  "/><Run Text="Your call" Foreground="{StaticResource Info}" FontWeight="SemiBold"/><Run Text=" remove it if you do not use it  •  "/><Run Text="Careful" Foreground="{StaticResource Pink}" FontWeight="SemiBold"/><Run Text=" other programs, games or your devices may need it"/></TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- Summary -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-8,12">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="PROGRAMS AND APPS" Style="{StaticResource StatLabel}" Foreground="{StaticResource Brand}"/><TextBlock x:Name="SumCount" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="SPACE THEY USE" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumSize" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="INSTALLED IN THE LAST 30 DAYS" Style="{StaticResource StatLabel}" Foreground="{StaticResource Info}"/><TextBlock x:Name="SumRecent" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="BIGGEST" Style="{StaticResource StatLabel}" Foreground="{StaticResource Pink}"/><TextBlock x:Name="SumBiggest" Text="--" Style="{StaticResource StatValue}" FontSize="18" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    </UniformGrid>

    <!-- List | details -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
            <ComboBox x:Name="SortBy" DockPanel.Dock="Right" Width="170" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Sort the list">
              <ComboBoxItem Content="Biggest first" Tag="Size" IsSelected="True"/>
              <ComboBoxItem Content="Name A-Z" Tag="Name"/>
              <ComboBoxItem Content="Newest first" Tag="Date"/>
            </ComboBox>
            <Grid VerticalAlignment="Center">
              <TextBox x:Name="Search" VerticalAlignment="Center" ToolTip="Type part of a name or publisher to filter the list."/>
              <TextBlock x:Name="SearchHint" Text="🔍  Search programs or publishers…" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="13"/>
            </Grid>
          </DockPanel>
          <ListView x:Name="Items" BorderThickness="0" Background="Transparent" Margin="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View><GridView>
              <GridViewColumn Header="Program" Width="330">
                <GridViewColumn.CellTemplate><DataTemplate>
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" Width="90">
                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" MinWidth="70" TextAlignment="Right"/></DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Installed" Width="100" DisplayMemberBinding="{Binding DateText}"/>
              <GridViewColumn Header="Our advice" Width="100">
                <GridViewColumn.CellTemplate><DataTemplate>
                  <Border CornerRadius="3" Padding="8,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                    <TextBlock x:Name="AdviceText" Text="{Binding Advice}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Info}"/>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Advice}" Value="Careful"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Pink}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView></ListView.View>
          </ListView>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="PanelLabel" Text="WHAT IS IT?" Style="{StaticResource StatLabel}"/>
            <TextBlock x:Name="ExplainTitle" Text="Click a program" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brand}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="ExplainSub" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExplainAdvice" Text="Pick a program to see what it is, how much space it uses, and to uninstall it. YUMRAM runs its own uninstaller and then cleans up what it leaves behind." Style="{StaticResource Answer}" Margin="0,10,0,0"/>
            <StackPanel x:Name="ExplainBody" Visibility="Collapsed">
              <TextBlock Text="WHERE IS IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainPath" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              <Button x:Name="Uninstall" Content="Uninstall…" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" MinHeight="38"/>
              <Button x:Name="OpenLocation" Content="📂  Show in File Explorer" Margin="0,8,0,0" ToolTip="Open the folder this program is installed in."/>
            </StackPanel>
            <!-- After an uninstall: what it left behind -->
            <StackPanel x:Name="LeftPanel" Visibility="Collapsed" Margin="0,16,0,0">
              <TextBlock Text="LEFT BEHIND" Style="{StaticResource StatLabel}"/>
              <TextBlock x:Name="LeftText" Text="" Style="{StaticResource Answer}"/>
              <ListView x:Name="Leftovers" BorderThickness="0" Background="Transparent" Margin="0,8,0,0" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View><GridView>
                  <GridViewColumn Header="" Width="34">
                    <GridViewColumn.CellTemplate><DataTemplate><CheckBox x:Name="Pick" IsChecked="{Binding Ticked, Mode=OneWay}" Tag="{Binding Path}" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="What" Width="280">
                    <GridViewColumn.CellTemplate><DataTemplate>
                      <StackPanel Margin="0,2" ToolTip="{Binding Path}">
                        <TextBlock Text="{Binding ShortPath}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Line2}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView></ListView.View>
              </ListView>
              <Button x:Name="RemoveLeftovers" Content="Remove ticked leftovers" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" MinHeight="36"/>
              <Button x:Name="SkipLeftovers" Content="Keep them" Style="{StaticResource GhostButton}" Margin="0,6,0,0"/>
              <Button x:Name="OpenBackups" Content="Open the backup folder" Style="{StaticResource GhostButton}" Margin="0,6,0,0" Visibility="Collapsed" ToolTip="Registry backups (.reg): double-click one to put those settings back."/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="Close" DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      <TextBlock x:Name="Details" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
