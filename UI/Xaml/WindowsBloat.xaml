<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows bloat (5.15). Names used by Show-YumWindowsBloat in UI\WindowsBloatPage.ps1.
  Layout: header -> summary cards -> [preinstalled apps | Windows settings] | details panel -> footer.
  Everything here is reversible: apps come back from the Microsoft Store, settings are undone exactly.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Windows bloat" Width="1160" Height="780" MinWidth="920" MinHeight="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Answer" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="Question" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="Margin" Value="0,14,0,2"/></Style>
    <DataTemplate x:Key="AdvicePill">
      <Border CornerRadius="9" Padding="8,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
        <TextBlock x:Name="AdviceText" Text="{Binding Suggest}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Info}"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Suggest}" Value="Remove"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Suggest}" Value="Recommended"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="AdminPill" Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock x:Name="AdminText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
        </Border>
        <Button x:Name="Reload" Content="↻  Check again" Style="{StaticResource GhostButton}" ToolTip="Read the app list and settings from Windows again."/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Windows bloat" Style="{StaticResource AppTitle}"/>
        <TextBlock Text="Apps that came with Windows and Windows settings that show ads, tips and suggestions. Everything here can be undone: removed apps come back from the Microsoft Store, and settings go back exactly as they were. YUMRAM never touches the Store, Edge, Windows Update, Defender or services." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <!-- Summary -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-8,12">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="PREINSTALLED APPS FOUND" Style="{StaticResource StatLabel}" Foreground="{StaticResource Brand}"/><TextBlock x:Name="SumApps" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="SAFE TO REMOVE" Style="{StaticResource StatLabel}" Foreground="{StaticResource Success}"/><TextBlock x:Name="SumSuggest" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="AD &amp; TIP SETTINGS STILL ON" Style="{StaticResource StatLabel}" Foreground="{StaticResource Pink}"/><TextBlock x:Name="SumSettings" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="REMOVED BY YUMRAM" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumRemoved" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
    </UniformGrid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Apps -->
        <Border Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="14,10,10,6">
              <Button x:Name="RemoveSuggested" DockPanel.Dock="Right" Content="Remove all safe ones" Style="{StaticResource GhostButton}" Padding="10,3" ToolTip="Removes every app marked Remove, after you confirm the list."/>
              <TextBlock Text="PREINSTALLED APPS" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListView x:Name="Apps" BorderThickness="0" Background="Transparent" Margin="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.View><GridView>
                <GridViewColumn Header="Advice" Width="128" CellTemplate="{StaticResource AdvicePill}"/>
                <GridViewColumn Header="App" Width="300">
                  <GridViewColumn.CellTemplate><DataTemplate>
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="State" Width="110">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding State}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView></ListView.View>
            </ListView>
          </DockPanel>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="14,10,10,6">
              <Button x:Name="ApplyRecommended" DockPanel.Dock="Right" Content="Turn off all recommended" Style="{StaticResource GhostButton}" Padding="10,3" ToolTip="Turns off every setting marked Recommended, after you confirm. Each can be undone."/>
              <TextBlock Text="WINDOWS ADS, TIPS AND SUGGESTIONS" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListView x:Name="Settings" BorderThickness="0" Background="Transparent" Margin="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.View><GridView>
                <GridViewColumn Header="Advice" Width="128" CellTemplate="{StaticResource AdvicePill}"/>
                <GridViewColumn Header="Setting" Width="330">
                  <GridViewColumn.CellTemplate><DataTemplate>
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Now" Width="90">
                  <GridViewColumn.CellTemplate><DataTemplate>
                    <TextBlock x:Name="StateText" Text="{Binding State}" FontWeight="SemiBold" Foreground="{StaticResource Pink}"/>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding State}" Value="Off"><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView></ListView.View>
            </ListView>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Details -->
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="WHAT IS IT?" Style="{StaticResource StatLabel}"/>
            <TextBlock x:Name="ExplainTitle" Text="Click an app or a setting" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brand}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="ExplainSub" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExplainWhy" Text="Pick an app to see what it is and whether it is safe to remove, or a setting to see what turning it off does." Style="{StaticResource Answer}" Margin="0,10,0,0"/>
            <StackPanel x:Name="ExplainBody" Visibility="Collapsed">
              <TextBlock Text="WHAT HAPPENS?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainEffect" Style="{StaticResource Answer}"/>
              <TextBlock Text="CAN I UNDO IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainUndo" Style="{StaticResource Answer}"/>
              <CheckBox x:Name="ForNewUsers" Content="Also for new user accounts (administrator)" Margin="0,14,0,0" Foreground="{StaticResource Text}" ToolTip="Also removes the copy Windows keeps for setting up new user accounts. Needs YUMRAM to run as administrator."/>
              <Button x:Name="Act" Content="Remove" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" MinHeight="38"/>
              <Button x:Name="Undo" Content="Undo" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock Text="REMOVED BY YUMRAM" Style="{StaticResource Question}" Margin="0,22,0,2"/>
            <ListBox x:Name="History" MaxHeight="160" Background="Transparent" BorderThickness="0" DisplayMemberPath="Label"/>
            <Button x:Name="GetBack" Content="Get it back (Microsoft Store)" Style="{StaticResource GhostButton}" Margin="0,6,0,0" IsEnabled="False" ToolTip="Opens the Microsoft Store page of the app selected above so you can install it again."/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="Close" DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      <TextBlock x:Name="Details" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
