<?xml version="1.0" encoding="utf-8"?>
<!--
  Startup apps (5.7). Names used by Show-YumStartupApps in UI\StartupPage.ps1.
  Layout: header -> summary cards -> list | "Should I turn it off?" panel -> footer.
  On/off uses the same Windows flag as Task Manager, so nothing is ever deleted.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YUMRAM - Startup apps" Width="1120" Height="740" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Answer" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="Question" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="Margin" Value="0,14,0,2"/></Style>
  </Window.Resources>
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="AdminPill" Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock x:Name="AdminText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
        </Border>
        <Button x:Name="Reload" Content="↻  Check again" Style="{StaticResource GhostButton}" ToolTip="Read the startup list from Windows again."/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Startup apps" Style="{StaticResource AppTitle}"/>
        <TextBlock Text="Programs that start by themselves when you sign in. Every one that starts uses RAM all day, even if you never open it. Turning one off does not uninstall it - you can still open it yourself, and turn it back on here or in Task Manager." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"><Run Text="Our advice:  "/><Run Text="Turn off (recommended)" Foreground="{StaticResource Success}" FontWeight="SemiBold"/><Run Text=" nothing breaks  •  "/><Run Text="Your call" Foreground="{StaticResource Info}" FontWeight="SemiBold"/><Run Text=" depends whether you use it  •  "/><Run Text="Keep on" Foreground="{StaticResource Pink}" FontWeight="SemiBold"/><Run Text=" Windows, security or your devices need it"/></TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- Summary -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-8,12">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="START WITH WINDOWS" Style="{StaticResource StatLabel}" Foreground="{StaticResource Brand}"/><TextBlock x:Name="SumOn" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="TURNED OFF" Style="{StaticResource StatLabel}"/><TextBlock x:Name="SumOff" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="RAM THEY USE NOW" Style="{StaticResource StatLabel}" Foreground="{StaticResource Pink}"/><TextBlock x:Name="SumRam" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="SAFE TO TURN OFF" Style="{StaticResource StatLabel}" Foreground="{StaticResource Success}"/><TextBlock x:Name="SumSuggest" Text="--" Style="{StaticResource StatValue}" FontSize="22"/></StackPanel></Border>
    </UniformGrid>

    <!-- List | details -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
        <ListView x:Name="Items" BorderThickness="0" Background="Transparent" Margin="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.View><GridView>
            <GridViewColumn Header="Starts" Width="78">
              <GridViewColumn.CellTemplate><DataTemplate>
                <Border x:Name="StatePill" CornerRadius="9" Padding="10,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                  <TextBlock x:Name="StateText" Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Enabled}" Value="True"><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Program" Width="270">
              <GridViewColumn.CellTemplate><DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Friendly}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SubTitle}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="RAM now" Width="100">
              <GridViewColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding MemoryText}" FontWeight="SemiBold" HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"/>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Our advice" Width="175">
              <GridViewColumn.CellTemplate><DataTemplate>
                <Border CornerRadius="9" Padding="8,1" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                  <TextBlock x:Name="AdviceText" Text="{Binding AdviceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Suggestion}" Value="Turn off"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Suggestion}" Value="Keep"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Pink}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Suggestion}" Value="Careful"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Pink}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Suggestion}" Value="Your call"><Setter TargetName="AdviceText" Property="Foreground" Value="{StaticResource Info}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView></ListView.View>
        </ListView>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="SHOULD I TURN IT OFF?" Style="{StaticResource StatLabel}"/>
            <TextBlock x:Name="ExplainTitle" Text="Click a program" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brand}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="ExplainSub" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExplainAdvice" Text="Pick a program to see what it is, how much RAM it uses right now, and whether it is safe to stop it from starting with Windows." Style="{StaticResource Answer}" Margin="0,10,0,0"/>
            <StackPanel x:Name="ExplainBody" Visibility="Collapsed">
              <TextBlock Text="RIGHT NOW" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainNow" Style="{StaticResource Answer}"/>
              <TextBlock Text="WHAT HAPPENS IF I TURN IT OFF?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainEffect" Style="{StaticResource Answer}"/>
              <TextBlock Text="WHERE IS IT?" Style="{StaticResource Question}"/>
              <TextBlock x:Name="ExplainPath" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              <Button x:Name="Toggle" Content="Turn off at startup" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" MinHeight="38"/>
              <Button x:Name="OpenLocation" Content="📂  Show in File Explorer" Margin="0,8,0,0" ToolTip="Open the folder that contains this program, with the file selected."/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="Close" DockPanel.Dock="Right" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      <TextBlock x:Name="Details" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
